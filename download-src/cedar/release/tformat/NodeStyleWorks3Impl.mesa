NameError[frame, name, p]; RETURN [FlushLeft] };
style.lastLineFormatting ¨ SELECT name FROM
$justified => Justified,
$flushLeft => FlushLeft,
$flushRight => FlushRight,
$centered => Centered,
ENDCASE => Error[];
};
