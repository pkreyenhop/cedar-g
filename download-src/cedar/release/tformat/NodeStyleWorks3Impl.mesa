NameError[frame, name, p]; RETURN [FlushLeft] };
style.lineFormatting ¨ SELECT name FROM
$justified => Justified,
$flushLeft => FlushLeft,
$flushRight => FlushRight,
$centered => Centered,
ENDCASE => Error[];
};

