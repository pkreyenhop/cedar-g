[v: Viewer] RETURNS [BOOL _ TRUE]
PROC[parent: ViewerClasses.Viewer, clientData: REF ANY _ NIL, mouseButton: ViewerClasses.MouseButton _ red, shift: BOOL _ FALSE, control: BOOL _ FALSE]
icon: Icons.IconFlavor;
icon _ Icons.NewIconFromFile["InterpreterTool.icons", 6
! FS.Error => GO TO noGood];
IF icon # unInit THEN needsToBeCompiled _ icon;
EXITS noGood => {};
