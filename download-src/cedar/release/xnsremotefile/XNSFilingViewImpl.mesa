UnImplemented["XNSFilingViewImpl.RetrieveInner"];
};
CallMonitored[vfs, RetrieveInner];
};

Attach: PFSClass.AttachProc ~ {
class: PFSClass.FSHandle ~ h;
vfs: VFS ~ NARROW[class.data];
AttachInner: TransportProc ~ {
ENABLE UNWIND => { NULL };
toFName ¬ NIL;
