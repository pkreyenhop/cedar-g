vfs: VFS ~ NARROW[class.data];
GetClientPropertyInner: TransportProc ~ {
ENABLE UNWIND => { NULL };
propertyValue ¬ NIL;
UnImplemented["XNSFilingViewImpl.GetClientPropertyInner"];
};
