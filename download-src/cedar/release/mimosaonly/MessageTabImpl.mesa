
DIRECTORY
ConvertUnsafe USING [ToRope],
MessageTab USING [],
MimosaLog USING [ErrorCode],
Rope USING [ROPE],
Symbols USING [TransferMode, TypeClass],
Tree USING [NodeName];
MessageTabImpl: PROGRAM
IMPORTS ConvertUnsafe
EXPORTS MessageTab = {

ROPE: TYPE = Rope.ROPE;

NodePrintName: PUBLIC PROC [name: Tree.NodeName] RETURNS [ROPE] = {
str: STRING ¬ NIL;
SELECT name FROM
list => str ¬ "list";
