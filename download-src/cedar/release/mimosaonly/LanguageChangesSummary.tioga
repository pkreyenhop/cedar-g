ù =/␀␀ñ(cedardoc) styleïStyleDef∫BeginStyle

(Cedar) AttachStyle

(FontFamily) "main font" {"Classic" family} StyleRule
(AlternateFontFamily) "other font" {"Modern" family} StyleRule
(CodeFont) "code font" {"Modern" family} StyleRule
(FixedPitchFont) "fixed pitch font" {"Quartz" family} StyleRule
(LogoFont) "Xerox logo font" {"Xerox/XC1-2-2/Logotypes-Xerox" family} StyleRule
(FontPrefix) "default font prefix" {"Xerox/XC1-3-3/" fontPrefix} StyleRule

(firstHeadersAfterPage) {0} .cvx .def

(root) "format for root nodes" {
  FontPrefix
  docStandard
  36 pt topMargin
  36 pt headerMargin
  .5 in footerMargin
  .5 in bottomMargin
  1.5 in leftMargin
  1.5 in rightMargin
  8.5 in the leftMargin .sub the rightMargin .sub lineLength
  24 pt topIndent
  24 pt topLeading
  0 leftIndent
  10 pt rightIndent
  } StyleRule
  
(positionInternalMemoLogo) "Xerox logo: screen" {
  docStandard
  1 pt leading
  1 pt topLeading
  1 pt bottomLeading
  } ScreenRule

(positionInternalMemoLogo) "for Xerox logo" {
  docStandard
  1 pt leading
  1 pt topLeading
  -1.0 in leftIndent
  } PrintRule

(internalMemoLogo) "Xerox logo: screen" {
  "Logo" family
  18 bp size
  20 pt topLeading
  20 pt bottomLeading
  } ScreenRule

(internalMemoLogo) "for Xerox logo" {
  "Logo" family
  18 pt size
  12 pt leading
  36 pt bottomLeading
  -1.0 in leftIndent
  } PrintRule

(memoHead) "for the To, From, Subject nodes at front of memos" {
  docStandard
  AlternateFontFamily
  240 pt tabStops
  } StyleRule

EndStyleïNewlineDelimiter
