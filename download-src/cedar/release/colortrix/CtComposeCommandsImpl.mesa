ELSE {
image: PixelArray _ CtFile.ReadPixelArray[FullName[Args.GetRope[cmd, 0]]];
matte: PixelArray _ CtFile.ReadPixelArray[FullName[Args.GetRope[cmd, 1]]];
box: Box _ SF.Intersect[ImagerSample.GetBox[maps[0].map], CtBasic.IntersectionOfPixelArrays[image, matte]];
width: NAT _ box.max.f-box.min.f;
FOR y: NAT IN [box.min.s..box.max.s) DO
matteBuf: SampleBuffer _ matte[y];
imageBuf: SampleBuffer _ image[y];
Process.CheckForAbort[];
FOR x: NAT IN [box.min.f..box.max.f) DO
imageBuf[x] _ imageBuf[x]*matteBuf[x]/255;
ENDLOOP;
ImagerSample.PutSamples[maps[0].map, [y, box.min.f],, imageBuf, box.min.f, width];
ENDLOOP;
};
FOR y: NAT IN [box.min.s..box.max.s) DO
matteBuf: SampleBuffer _ matte[y];
imageBuf: SampleBuffer _ image[y];
ImagerSample.GetSamples[background, [y, box.min.f],, backgroundBuf, 0, width];
Process.CheckForAbort[];
FOR x: NAT IN [box.min.f..box.max.f) DO
a: REAL ~ (1.0/255.0)*REAL[matteBuf[x]];
b: REAL _ REAL[backgroundBuf[x]];
imageBuf[x] _ Real.Round[b+a*(REAL[imageBuf[x]]-b)];
ENDLOOP;
ImagerSample.PutSamples[background, [y, box.min.f],, imageBuf, box.min.f, width];
ENDLOOP;
