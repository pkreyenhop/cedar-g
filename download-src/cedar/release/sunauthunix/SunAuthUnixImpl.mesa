GetThisMachineName: PROC RETURNS [name: ROPE] ~ {
IF (name _ cachedMachineName) = NIL THEN {
ENABLE SunYPAgent.Error => GOTO NoYP;
cachedMachineName _ name _ ThisMachine.Name[$ip];
EXITS
NoYP => NULL;
};
