GetError: PUBLIC CrRPC.GetErrorProc ~ {
SELECT errNum FROM
9  => {
problem: HandleProblem;
problem ¨ VAL[CrRPC.GetCard16[s]];
ERROR HandleError[problem]
};
2  => {
problem: ArgumentProblem;
type: ControlType;
problem ¨ VAL[CrRPC.GetCard16[s]];
type ¨ VAL[CrRPC.GetCard16[s]];
ERROR ControlTypeError[problem, type]
};
14  => {
problem: TransferProblem;
problem ¨ VAL[CrRPC.GetCard16[s]];
ERROR TransferError[problem]
};
13  => {
problem: SpaceProblem;
problem ¨ VAL[CrRPC.GetCard16[s]];
ERROR SpaceError[problem]
};
11  => {
problem: ServiceProblem;
problem ¨ VAL[CrRPC.GetCard16[s]];
ERROR ServiceError[problem]
};
16  => {
problem: ArgumentProblem;
problem ¨ VAL[CrRPC.GetCard16[s]];
ERROR RangeError[problem]
};
12  => {
problem: SessionProblem;
problem ¨ VAL[CrRPC.GetCard16[s]];
ERROR SessionError[problem]
};
15  => {
problem: CARD16;
problem ¨ CrRPC.GetCard16[s];
ERROR UndefinedError[problem]
};
8  => {
problem: ConnectionProblem;
problem ¨ VAL[CrRPC.GetCard16[s]];
ERROR ConnectionError[problem]
};
7  => {
problem: AuthenticationP14V2.Problem;
problem ¨ VAL[CrRPC.GetCard16[s]];
ERROR AuthenticationError[problem]
};
5  => {
problem: ArgumentProblem;
type: ScopeType;
problem ¨ VAL[CrRPC.GetCard16[s]];
type ¨ VAL[CrRPC.GetCard16[s]];
ERROR ScopeValueError[problem, type]
};
1  => {
problem: ArgumentProblem;
type: CARD32;
problem ¨ VAL[CrRPC.GetCard16[s]];
type ¨ CrRPC.GetCard32[s];
ERROR AttributeValueError[problem, type]
};
10  => {
problem: InsertionProblem;
problem ¨ VAL[CrRPC.GetCard16[s]];
ERROR InsertionError[problem]
};
3  => {
problem: ArgumentProblem;
type: ControlType;
problem ¨ VAL[CrRPC.GetCard16[s]];
type ¨ VAL[CrRPC.GetCard16[s]];
ERROR ControlValueError[problem, type]
};
6  => {
problem: AccessProblem;
problem ¨ VAL[CrRPC.GetCard16[s]];
ERROR AccessError[problem]
};
0  => {
problem: ArgumentProblem;
type: CARD32;
problem ¨ VAL[CrRPC.GetCard16[s]];
type ¨ CrRPC.GetCard32[s];
ERROR AttributeTypeError[problem, type]
};
4  => {
problem: ArgumentProblem;
type: ScopeType;
problem ¨ VAL[CrRPC.GetCard16[s]];
type ¨ VAL[CrRPC.GetCard16[s]];
ERROR ScopeTypeError[problem, type]
};
ENDCASE => {
ERROR CrRPC.Error[h, remoteError, "Unexpected Remote Error"];
};
};


