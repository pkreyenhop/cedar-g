};

MProc70: PROC [h: CrRPC.Handle, s: CrRPC.STREAM, val: Scope] ~ {
CrRPC.PutCard16[s, ORD[val.type]];
WITH val SELECT FROM
it: REF ScopeObject.count => {
CrRPC.PutCard16[s, it≠.count];
};
it: REF ScopeObject.depth => {
CrRPC.PutCard16[s, it≠.depth];
};
it: REF ScopeObject.direction => {
CrRPC.PutCard16[s, ORD[it≠.direction]];
};
it: REF ScopeObject.filter => {
MProc72[h, s, it≠.filter];
};
ENDCASE;
};

MProc13: PROC [h: CrRPC.Handle, s: CrRPC.STREAM, val: ControlSequence] ~ {
