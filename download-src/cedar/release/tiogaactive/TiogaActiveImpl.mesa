RememberCurrentPosition: PUBLIC PROC [viewer: Viewer] = {
Copied from TEditDocuments2Impl.RememberCurrentPosition
tdd: TEditDocument.TEditDocumentData _ NARROW[viewer.data];
prop: REF PositionHistory _ NARROW[ViewerOps.FetchProp[viewer, $PositionHistory]];
loc: TextNode.Location;
IF tdd=NIL THEN RETURN;
IF prop = NIL THEN {
prop _ NEW[PositionHistory];
ViewerOps.AddProp[viewer, $PositionHistory, prop] };
[] _ TEditDocument.SpinAndLock[tdd, "RememberCurrentPosition"];
loc _ tdd.lineTable.lines[0].pos;
TEditDocument.Unlock[tdd];
IF loc = prop.pos THEN RETURN;
prop.prev _ prop.pos; prop.pos _ loc;
};

