["Reset", ResetProc, 1, 50],
["SetFields", SetFieldsProc, 1, 80],
["Output file:", ReportOutputFileProc, 2, 105],
["SKIP", DeadBProc, 2, 164],
["Template file:", ReportTemplateFileProc, 2, 120],
["SKIP", DeadBProc, 2, 190],
["QL to use:", WhichQLProc, 3, 100],
["SKIP", DeadBProc, 3, 190],
nullButton];

QueryButtons: ButtonsList = LIST  [
