AdobeCommon USING [--ChangeSystem, DataHandle, FreeHintStrings, GetDataSW, GetDescList, --Handle, InitialSetStatus--, LockedSysDescPtr--, PostMessage, ReportFields, ReportFieldsSeq, SetStatus--, StringArray--],
