IF eMsg # NIL THEN IO.PutF1[reports, "%g\N", [rope[eMsg]]];
END;

RemoveSearchDirectory: PUBLIC PROC [connection: Connection, directoryPath: Rope.ROPE, reports: IO.STREAM]  =
