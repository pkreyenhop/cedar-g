Return NIL if directory doesn't exist; if no files in directory, names.length = 0.
Command
in ¨ IO.RIS[PFS.RopeOpen[PFS.PathFromRope[name]].rope
! PFS.Error => GOTO Bad];
Eq[args[i], "-open"] => {
IF NoSwitchArg[i+1] THEN {
column: ROPE ¨ IF Eq[NextArg[], "right"] THEN "-right " ELSE NIL;
IF NoSwitchArg[i+1] THEN {
newArgs: ROPE ¨ NIL;
WHILE NoSwitchArg[i+1] DO
newArgs ¨ Rope.Cat[newArgs, " ", NextArg[]];
ENDLOOP;
[] ¨ CommanderOps.DoCommand[Rope.Cat["Open ", column, newArgs], cmd];
EXIT;
};
};
IO.PutRope[cmd.out, "insufficient open arguments\n"];
};
Usage Messages
openUsage: ROPE ~
"\t-open <left | right> <file name pattern>\n\t\topen the file(s) in the given column\n";

openUsage,
