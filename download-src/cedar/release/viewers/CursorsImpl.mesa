140003B, 140003B, 177777B, 177777B];
};
blank => {
global.info ¬ [blank, 0,0, FALSE];
global.bits ¬ [
000000B, 000000B, 000000B, 000000B,
000000B, 000000B, 000000B, 000000B,
000000B, 000000B, 000000B, 000000B,
000000B, 000000B, 000000B, 000000B];
};
confirm => {
global.info ¬ [confirm, 0,0, FALSE];
global.bits ¬ [
