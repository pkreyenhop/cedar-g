
DIRECTORY G2dBasic, Real, RealFns;

G2dBasicImpl: CEDAR PROGRAM
IMPORTS Real, RealFns 
EXPORTS G2dBasic

~ BEGIN

Border:						TYPE ~ G2dBasic.Border;
Box2d:						TYPE ~ G2dBasic.Box;
Card3:							TYPE ~ G2dBasic.Card3;
Integer3:						TYPE ~ G2dBasic.Integer3;
IntegerPair:					TYPE ~ G2dBasic.IntegerPair;
IntegerPairSequence:		TYPE ~ G2dBasic.IntegerPairSequence;
IntegerPairSequenceRep:	TYPE ~ G2dBasic.IntegerPairSequenceRep;
IntegerSequence:				TYPE ~ G2dBasic.IntegerSequence;
IntegerSequenceRep: 		TYPE ~ G2dBasic.IntegerSequenceRep;
IntPair:						TYPE ~ G2dBasic.IntPair;
IntPairSequence:				TYPE ~ G2dBasic.IntPairSequence;
IntPairSequenceRep:			TYPE ~ G2dBasic.IntPairSequenceRep;
IntSequence:					TYPE ~ G2dBasic.IntSequence;
IntSequenceRep: 			TYPE ~ G2dBasic.IntSequenceRep;
Nat3:							TYPE ~ G2dBasic.Nat3;
NatPair:						TYPE ~ G2dBasic.NatPair;
NatPairSequence:			TYPE ~ G2dBasic.NatPairSequence;
NatPairSequenceRep:		TYPE ~ G2dBasic.NatPairSequenceRep;
NatSequence:					TYPE ~ G2dBasic.NatSequence;
NatSequenceRep: 			TYPE ~ G2dBasic.NatSequenceRep;
Pair:							TYPE ~ G2dBasic.Pair;
PairSequence:				TYPE ~ G2dBasic.PairSequence;
PairSequenceRep:			TYPE ~ G2dBasic.PairSequenceRep;
RealSequence:				TYPE ~ G2dBasic.RealSequence;
RealSequenceRep:			TYPE ~ G2dBasic.RealSequenceRep;
Sign:							TYPE ~ G2dBasic.Sign;
Triple:						TYPE ~ G2dBasic.Triple;

PI:								REAL ~ 3.1415926535;
ArcCos: PUBLIC PROC [cos: REAL] RETURNS [a: REAL] ~ {
x: REAL ~ MIN[1.0, MAX[-1.0, cos]];
a м IF x < 0.95
THEN					-- Method 1 --
RealFns.ArcTan[RealFns.SqRt[1.0-x*x], x]	-- save a divide
ELSE IF x = -1.0		-- Method 2 --
THEN PI
ELSE 2.0*RealFns.ArcTan[RealFns.SqRt[(1.0-x)/(1.0+x)], 1.0];
};

ArcCosDeg: PUBLIC PROC [cos: REAL] RETURNS [REAL] ~ {
RETURN[ArcCos[cos]*180.0/PI];
};

CopyNatSequence: PUBLIC PROC [nats: NatSequence]
RETURNS [NatSequence] ~ {
copy: NatSequence м NIL;
IF nats # NIL THEN {
copy м NEW[NatSequenceRep[nats.length]];
copy.length м nats.length;
FOR n: NAT IN [0..nats.length) DO copy[n] м nats[n]; ENDLOOP;
};
RETURN[copy];
};

CopyIntegerSequence: PUBLIC PROC [integers: IntegerSequence]
RETURNS [IntegerSequence] ~ {
copy: IntegerSequence м NIL;
IF integers # NIL THEN {
copy м NEW[IntegerSequenceRep[integers.length]];
copy.length м integers.length;
FOR n: NAT IN [0..integers.length) DO copy[n] м integers[n]; ENDLOOP;
};
RETURN[copy];
};

CopyIntSequence: PUBLIC PROC [ints: IntSequence] RETURNS [IntSequence] ~ {
copy: IntSequence м NIL;
IF ints # NIL THEN {
copy м NEW[IntSequenceRep[ints.length]];
copy.length м ints.length;
FOR n: NAT IN [0..ints.length) DO copy[n] м ints[n]; ENDLOOP;
};
RETURN[copy];
};

CopyRealSequence: PUBLIC PROC [reals: RealSequence]
RETURNS [RealSequence] ~ {
copy: RealSequence м NIL;
IF reals # NIL THEN {
copy м NEW[RealSequenceRep[reals.length]];
copy.length м reals.length;
FOR n: NAT IN [0..reals.length) DO copy[n] м reals[n]; ENDLOOP;
};
RETURN[copy];
};

CopyPairSequence: PUBLIC PROC [pairs: PairSequence]
RETURNS [PairSequence] ~ {
copy: PairSequence м NIL;
IF pairs # NIL THEN {
copy м NEW[PairSequenceRep[pairs.length]];
copy.length м pairs.length;
FOR n: NAT IN [0..pairs.length) DO copy[n] м pairs[n]; ENDLOOP;
};
RETURN[copy];
};

CopyIntPairSequence: PUBLIC PROC [intPairs: IntPairSequence]
RETURNS [IntPairSequence]
~ {
copy: IntPairSequence м NIL;
IF intPairs # NIL THEN {
copy м NEW[IntPairSequenceRep[intPairs.length]];
copy.length м intPairs.length;
FOR n: NAT IN [0..intPairs.length) DO copy[n] м intPairs[n]; ENDLOOP;
};
RETURN[copy];
};

CopyIntegerPairSequence: PUBLIC PROC [integerPairs: IntegerPairSequence]
RETURNS [IntegerPairSequence]
~ {
copy: IntegerPairSequence м NIL;
IF integerPairs # NIL THEN {
copy м NEW[IntegerPairSequenceRep[integerPairs.length]];
copy.length м integerPairs.length;
FOR n: NAT IN [0..integerPairs.length) DO copy[n] м integerPairs[n]; ENDLOOP;
};
RETURN[copy];
};

CopyNatPairSequence: PUBLIC PROC [natPairs: NatPairSequence]
RETURNS [NatPairSequence]
~ {
copy: NatPairSequence м NIL;
IF natPairs # NIL THEN {
copy м NEW[NatPairSequenceRep[natPairs.length]];
copy.length м natPairs.length;
FOR n: NAT IN [0..natPairs.length) DO copy[n] м natPairs[n]; ENDLOOP;
};
RETURN[copy];
};
AddToNatSequence: PUBLIC PROC [nats: NatSequence, nat: NAT]
RETURNS [NatSequence]
~ {
IF nats = NIL THEN nats м NEW[NatSequenceRep[1]];
IF nats.length = nats.maxLength THEN nats м LengthenNatSequence[nats];
nats[nats.length] м nat;
nats.length м nats.length+1;
RETURN[nats];
};
AddToIntegerSequence: PUBLIC PROC [integers: IntegerSequence, integer: INTEGER]
RETURNS [IntegerSequence]
~ {
IF integers = NIL THEN integers м NEW[IntegerSequenceRep[1]];
IF integers.length = integers.maxLength THEN integers м LengthenIntegerSequence[integers];
integers[integers.length] м integer;
integers.length м integers.length+1;
RETURN[integers];
};
AddToIntSequence: PUBLIC PROC [ints: IntSequence, int: INT]
RETURNS [IntSequence]
~ {
IF ints = NIL THEN ints м NEW[IntSequenceRep[1]];
IF ints.length = ints.maxLength THEN ints м LengthenIntSequence[ints];
ints[ints.length] м int;
ints.length м ints.length+1;
RETURN[ints];
};
AddToRealSequence: PUBLIC PROC [reals: RealSequence, real: REAL]
RETURNS [RealSequence]
~ {
IF reals = NIL THEN reals м NEW[RealSequenceRep[1]];
IF reals.length = reals.maxLength THEN reals м LengthenRealSequence[reals];
reals[reals.length] м real;
reals.length м reals.length+1;
RETURN[reals];
};
AddToPairSequence: PUBLIC PROC [pairs: PairSequence, pair: Pair]
RETURNS [PairSequence]
~ {
IF pairs = NIL THEN pairs м NEW[PairSequenceRep[1]];
IF pairs.length = pairs.maxLength THEN pairs м LengthenPairSequence[pairs];
pairs[pairs.length] м pair;
pairs.length м pairs.length+1;
RETURN[pairs];
};
AddToNatPairSequence: PUBLIC PROC [natPairs: NatPairSequence, natPair: NatPair]
RETURNS [NatPairSequence]
~ {
IF natPairs = NIL THEN natPairs м NEW[NatPairSequenceRep[1]];
IF natPairs.length = natPairs.maxLength THEN natPairs м LengthenNatPairSequence[natPairs];
natPairs[natPairs.length] м natPair;
natPairs.length м natPairs.length+1;
RETURN[natPairs];
};
AddToIntPairSequence: PUBLIC PROC [intPairs: IntPairSequence, intPair: IntPair]
RETURNS [IntPairSequence]
~ {
IF intPairs = NIL THEN intPairs м NEW[IntPairSequenceRep[1]];
IF intPairs.length = intPairs.maxLength THEN intPairs м LengthenIntPairSequence[intPairs];
intPairs[intPairs.length] м intPair;
intPairs.length м intPairs.length+1;
RETURN[intPairs];
};
AddToIntegerPairSequence: PUBLIC PROC [
integerPairs: IntegerPairSequence, integerPair: IntegerPair]
RETURNS [IntegerPairSequence]
~ {
IF integerPairs = NIL THEN integerPairs м NEW[IntegerPairSequenceRep[1]];
IF integerPairs.length = integerPairs.maxLength
THEN integerPairs м LengthenIntegerPairSequence[integerPairs];
integerPairs[integerPairs.length] м integerPair;
integerPairs.length м integerPairs.length+1;
RETURN[integerPairs];
};
LengthenNatSequence: PUBLIC PROC [nats: NatSequence, amount: REAL м 1.3]
RETURNS [new: NatSequence] ~ {
newLength: CARDINAL м Real.Ceiling[amount*nats.maxLength];
newLength м MAX[newLength, 3];
new м NEW[NatSequenceRep[newLength]];
FOR i: NAT IN [0..nats.length) DO new[i] м nats[i]; ENDLOOP;
new.length м nats.length;
};

LengthenIntegerSequence: PUBLIC PROC [integers: IntegerSequence, amount: REAL м 1.3]
RETURNS [new: IntegerSequence] ~ {
newLength: NAT м MAX[Real.Ceiling[amount*integers.maxLength], 3];
new м NEW[IntegerSequenceRep[newLength]];
FOR i: NAT IN [0..integers.length) DO new[i] м integers[i]; ENDLOOP;
new.length м integers.length;
};

LengthenIntSequence: PUBLIC PROC [ints: IntSequence, amount: REAL м 1.3]
RETURNS [new: IntSequence] ~ {
newLength: NAT м MAX[Real.Ceiling[amount*ints.maxLength], 3];
new м NEW[IntSequenceRep[newLength]];
FOR i: NAT IN [0..ints.length) DO new[i] м ints[i]; ENDLOOP;
new.length м ints.length;
};

LengthenRealSequence: PUBLIC PROC [reals: RealSequence, amount: REAL м 1.3]
RETURNS [new: RealSequence] ~ {
newLength: NAT м MAX[Real.Ceiling[amount*reals.maxLength], 3];
new м NEW[RealSequenceRep[newLength]];
FOR i: NAT IN [0..reals.length) DO new[i] м reals[i]; ENDLOOP;
new.length м reals.length;
};

LengthenPairSequence: PUBLIC PROC [pairs: PairSequence, amount: REAL м 1.3]
RETURNS [new: PairSequence] ~ {
newLength: NAT м MAX[Real.Ceiling[amount*pairs.maxLength], 3];
new м NEW[PairSequenceRep[newLength]];
FOR i: NAT IN [0..pairs.length) DO new[i] м pairs[i]; ENDLOOP;
new.length м pairs.length;
};

LengthenNatPairSequence: PUBLIC PROC [natPairs: NatPairSequence, amount: REAL м 1.3]
RETURNS [new: NatPairSequence] ~ {
newLength: NAT м MAX[Real.Ceiling[amount*natPairs.maxLength], 3];
new м NEW[NatPairSequenceRep[newLength]];
FOR i: NAT IN [0..natPairs.length) DO new[i] м natPairs[i]; ENDLOOP;
new.length м natPairs.length;
};

LengthenIntPairSequence: PUBLIC PROC [intPairs: IntPairSequence, amount: REAL м 1.3]
RETURNS [new: IntPairSequence] ~ {
newLength: NAT м MAX[Real.Ceiling[amount*intPairs.maxLength], 3];
new м NEW[IntPairSequenceRep[newLength]];
FOR i: NAT IN [0..intPairs.length) DO new[i] м intPairs[i]; ENDLOOP;
new.length м intPairs.length;
};

LengthenIntegerPairSequence: PUBLIC PROC [
integerPairs: IntegerPairSequence, amount: REAL м 1.3]
RETURNS [new: IntegerPairSequence] ~ {
newLength: NAT м MAX[Real.Ceiling[amount*integerPairs.maxLength], 3];
new м NEW[IntegerPairSequenceRep[newLength]];
FOR i: NAT IN [0..integerPairs.length) DO new[i] м integerPairs[i]; ENDLOOP;
new.length м integerPairs.length;
};

END.


