MProc1: PROC [h: CrRPC.Handle, s: CrRPC.STREAM, val: AuthenticationP14V2.SeqWords] ~ {
CrRPC.PutCard16[s, val.length];
FOR i2: CARDINAL IN [0..val.length) DO
CrRPC.PutCard16[s, val.body[i2]];
ENDLOOP;
};

