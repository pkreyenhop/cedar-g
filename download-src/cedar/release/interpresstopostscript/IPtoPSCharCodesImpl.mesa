DoWithCode: PUBLIC PROC [name: ATOM, action: IPtoPS.DoWithCodeProc] ~ {
val: REF ¨ RefTab.Fetch[table, name].val;
IF val = NIL
THEN [] ¨ action[0, standard]
ELSE {
entry: REF Entry ¨ NARROW[val];
[] ¨ action[entry.code, entry.encodingVector];
};
};

Initialize[];

END.
