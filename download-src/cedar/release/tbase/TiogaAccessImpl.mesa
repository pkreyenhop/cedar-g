Putback stuff is harder than all the rest!
Largest size that will come from the small-grain allocator (see Allocator.maxSmallBlockSize)
CreateOneMoreLevel: PROC [writer: Writer] ~ {
IF writer.root = NIL THEN {
InsertRoot[writer, TextNode.NewTextNode[]];
}
ELSE {
new: TextNode.Ref _ TextNode.NewTextNode[];
new^ _ writer.root^;
writer.root.props _ NIL;
writer.root.hasstyledef _ writer.root.hasprefix _ writer.root.haspostfix _ writer.root.hascharprops _ writer.root.hascharsets _ writer.root.hasartwork _ FALSE;
new.last _ TRUE;
new.child _ writer.root;
new.next _ NIL;
writer.root.next _ new;
writer.root _ new;
writer.lastLevel _ writer.lastLevel + 1;
writer.level _ writer.level + 1;
};
};

Collects all the pieces together.
TEditInput.FreeTree[writer.root];
