XMesa16x: PROCEDURE = { -- from AR 333 + 1048
Bit: TYPE = [0..1];

Rec32: TYPE = RECORD [
SELECT OVERLAID * FROM
by1 => [bit: PACKED ARRAY [1..32] OF Bit]
ENDCASE];

Rec64: TYPE = RECORD [
SELECT OVERLAID * FROM
by1 => [bit: PACKED ARRAY [1..64] OF Bit]
ENDCASE];

PermPC1: PROC = 
BEGIN
in: POINTER TO Rec64;
temp: Rec64;
in _ @temp;
in.bit _ ALL[0];
{
outC: POINTER TO Rec32;
temp2: Rec32;
outC _ @temp2;
outC.bit _ [
in.bit[57],  --1
in.bit[49],  --2
in.bit[41],  --3
in.bit[33],  --4
in.bit[25],  --5
in.bit[17],  --6
in.bit[9],   --7
in.bit[1],   --8
in.bit[58],  --9
in.bit[50],  --10
in.bit[42],  --11
in.bit[34],  --12
in.bit[26],  --13
in.bit[18],  --14
in.bit[10],  --15
in.bit[2],   --16
in.bit[59],  --17
in.bit[51],  --18
in.bit[43],  --19
in.bit[35],  --20
in.bit[27],  --21
in.bit[19],  --22
in.bit[11],  --23
in.bit[3],   --24
in.bit[60],  --25
in.bit[52],  --26
in.bit[44],  --27
in.bit[36], , , , ];  --28
};
END;

PermPC1[];

};

