nBits: NAT = 16;
StippleFromRope: PROC [rope: ROPE] RETURNS [stipple: Color] = {
ENABLE IO.EndOfStream => {stipple ¨ Imager.black; CONTINUE};
bits: PACKED ARRAY [0..nBits) OF [0..1] ¨ ALL[0];
bitCount: NAT ¨ 0;
word: WORD;
f: IO.STREAM ¨ IO.RIS[rope];
UNTIL f.EndOf[] DO
c: CHAR ¨ f.GetChar[];
SELECT c FROM
'0 => {bits[bitCount] ¨ 0; bitCount ¨ bitCount+1};
'1 => {bits[bitCount] ¨ 1; bitCount ¨ bitCount+1};
ENDCASE => {};
ENDLOOP;
word ¨ LOOPHOLE[bits];
stipple ¨ ImagerColorPrivate.ColorFromStipple[word, [or, null]];
};

