Class: PopUpButton
Menu: ("Fonts"
  ((SetPressFont) "SetPressFont [GT]" "Set selected text objects to the Press font described in the Tioga selection (e.g. Helvetica-BI 22)")
  ((ShowFontValues) "ShowFont [G]" "Print the font data for the selected text object")
  ((SetPrintFont) "SetXCFont [GT]" "Set selected text objects to the XC font described in the Tioga selection (e.g. Cream-BI 22)")
  ((SetFontDetailed) "SetDetailedFont [GT]" "Set selected text objects to the detailed font description in the Tioga selection (e.g. xerox/xc1-1-2/helvetica [r1: 50.0 s: [15.0 15.0] r2: 20.0])")
  ((ShowDefaultFontValues) "ShowDefaultFont" "Print the current default font data")
  ((SetDefaultFontValues) "MakeDefaultFont [G]" "Set the current default font to the font of the selected text object")
  ((SetFontLiteral) "SetLiteralFont [GT]" "Set selected text objects to the literal font description in the Tioga selection (e.g. xerox/tiogafonts/tioga10 [r1: 0.0 s: [10.0 10.0] r2: 0.0] 10.0 1.0)")
  ((ShowFontValuesLiteral) "ShowLiteralFont [G]" "Print the literal font data for the selected text object")
  ((SetScreenFont) "SetScreenFont [GT]" "Set selected text objects to the screen font described in the Tioga selection (e.g. Tioga10-BI 10)")
  ((CopyAll) "CopyFontAndTransform [G]" "Copy the font family, face, and transform from the last selected text object to all other selected text objects")
  ()
  ((CopyFont) "CopyFamilyAndFace [G]" "Copy the font family and face from the last selected text object to all other selected text objects")
  ((MatchAll) "MatchLiteral [G]" "Select all text objects with fonts exactly matching the currently selected text object")
  ((MatchSelectedName) "MatchName [T]" "Select all text objects whose user font name contains the name in the current Tioga selection")
  ((MatchSelectedNameLiteral) "MatchNameLiteral [T]" "Select all text objects whose literal font name contains the name in the current Tioga selection")
  )
