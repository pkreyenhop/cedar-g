Class: PopUpButton
Menu: ("Fill"
  ((AreaColorFromColorTool) "FromColorTool [G]" "Make selected objects have the fill color in the ColorTool")
  ((PrintAreaColor) "ShowFillColor [G]" "Print fill color of selected objects")
  ((AreaColorToColorTool) "ToColorTool [G]" "Send the fill color of the selected objects to the ColorTool")
  ((AreaColorNone) "none [G]" "Make selected objects have no fill color")
  ((AreaColorFollowColorTool) "FollowColorTool [G]" "Selected fill colors will track the ColorTool. Any mouse click terminates FollowColorTool")
  ((AreaColorWhite) "white [G]" "Make selected objects have fill color white")
  ((AreaColorFromSelectedName) "FromSelectedName [GT]" "Make selected objects have the fill color named in the Tioga selection (e.g. vivid green)")
  ((SelectMatchingAreaCNS) "MatchSelectedName [T]" "Select objects whose fill color matches the name in the Tioga selection (e.g. vivid green)")
  ((AreaColorBlack) "black [G]" "Make selected objects have fill color black")
  ((AreaColorFromSelectedRGB) "FromSelectedRGB [GT]" "Make selected objects have the fill RGB specified in the Tioga selection (e.g. 0.5 0.9 0.67)")
  ((SelectMatchingAreaRGB) "MatchSelectedRGB [T]" "Select objects whose fill color matches the RGB in the Tioga selection (e.g. 0.5 0.9 0.67)")
  ((AreaColorGray) "gray [G]" "Make selected objects have fill color gray")
  ((CopyFillColor) "Copy [G]" "Copy the fill color from the last selected object to all other selected objects")
  ((ShowDefaultFillColor) "ShowDefault" "Print default fill color")
  ((SetDefaultFillColor) "MakeDefault [G]" "Set the default fill color from the currently selected object")
  ((SetWash White) "WashToWhite" "Create a color wash from the selected fill color to white")
  ((SetWash ColorTool) "WashToColorTool" "Create a color wash from the selected fill color to the ColorTool color")
  ((SetWash Black) "WashToBlack" "Create a color wash from the selected fill color to black")
  ((FillColorFromSelectedCMYK) "FromSelectedCMYK" "Make selected objects have the fill CMYK specified in the Tioga selection (e.g., 0.5 0.9 0.67 0.3)")
