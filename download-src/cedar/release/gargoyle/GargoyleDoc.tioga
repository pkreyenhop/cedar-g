Text T "Transform" xerox/tiogafonts/Helvetica10I [10.0 0.0 328.8586 0.0 10.0 393.0][1 1.0] F 1.0 props: ( F ) ls: 1.2 pList: ( (ButtonData Poppy1
Class: PopUpButton
Menu: ("Transform"
  ((Scale) "Scale [GT]" "Scale selected objects by the number in the Tioga selection")
  ((ScaleXY) "ScaleXY [GT]" "Scale selected objects in X and Y by the two numbers in the Tioga selection")
  ((UnScale) "UnScale [GT]" "Scale selected objects by the reciprocal of the number in the Tioga selection")
  ((Rotate) "Rotate [GT]" "Rotate selected objects CCW about the Anchor by the number of degrees in the Tioga selection")
  ((Rotate "90.0") "Rotate 90 [G]" "Rotate selected objects CCW about the Anchor by 90 degrees")
  ((UnRotate) "UnRotate [GT]" "Rotate selected objects CW about the Anchor by the number of degrees in the Tioga selection")
  ((TranslateX) "TranslateX [GT]" "Translate selected objects in X direction by the number in the Tioga selection")
  ((TranslateXY) "TranslateXY [GT]" "Translate selected objects in X and Y directions by the two numbers in the Tioga selection")
  ((TranslateY) "TranslateY [GT]" "Translate selected objects in Y direction by the number in the Tioga selection")
  ((ScaleX "-1.0") "MirrorX [G]" "Scale selected objects by -1.0 in X direction")
  ((Rotate "180.0") "MirrorXY [G]" "Rotate selected objects by 180 degrees")
  ((ScaleY "-1.0") "MirrorY [G]" "Scale selected objects by -1.0 in Y direction")
  ((ScaleX) "ScaleX [GT]" "Scale selected objects in X direction by the number in the Tioga selection")
  ((SixPointTransform) "SixPoint [G]" "See GargoyleDoc for explanation")
  ((ScaleY) "ScaleY [GT]" "Scale selected objects in Y direction by the number in the Tioga selection")
  ((UnScaleX) "UnScaleX [GT]" "Scale selected objects in X direction by the reciprocal of the number in the Tioga selection")
  ((FourPointTransform) "FourPoint [G]" "See GargoyleDoc for explanation")
  ((UnScaleY) "UnScaleY [GT]" "Scale selected objects in Y direction by the reciprocal of the number in the Tioga selection")
  )
MessageHandler: Gargoyle
Feedback: (
  (MouseMoved <SetCursor bullseye>)
  )) )

Text T "Overlap" xerox/tiogafonts/Helvetica10I [10.0 0.0 328.8586 0.0 10.0 377.946][1 1.0] F 1.0 props: ( F ) ls: 1.2 pList: ( (ButtonData Poppy1
Class: PopUpButton
Menu: ("Overlap"
  ((Top) "Front (^B) [G]" "Move selected objects to the front")
  ((ShowPriorityValue) "ShowValue [G]" "Show the priority number for the selected object")
  ((Bottom) "Back (^b) [G]" "Move selected objects to the back")
  ((UpOne) "ForwardOne [G]" "Move selected objects one layer toward the front")
  ((FindPriorityFromSelection) "MatchFromSelection [T]" "Select the object at the priority number in the Tioga selection")
  ((DownOne) "BackOne [G]" "Move selected objects one layer toward the back")
  ((PutInFront) "PutInFront [G]" "Move the first selected objects in front of the last selected object")
  ((Exchange) "Exchange [G]" "Swap priority of the two selected objects")
  ((PutBehind) "PutBehind [G]" "Move the first selected objects behind the last selected object")
  ((UpFromSelection) "ForwardFromSelection [GT]" "Move selected objects toward the front by the number in the Tioga selection")
  ((PutAtSelection) "PutAtSelection [GT]" "Put the selected objects at the priority number in the Tioga selection")
  ((DownFromSelection) "BackFromSelection [GT]" "Move selected objects toward the back by the number in the Tioga selection")
  )
MessageHandler: Gargoyle
Feedback: (
  (MouseMoved <SetCursor bullseye>)
  )) )

Text T "Edit" xerox/tiogafonts/Helvetica10I [10.0 0.0 328.8586 0.0 10.0 362.892][1 1.0] F 1.0 props: ( F ) ls: 1.2 pList: ( (ButtonData Poppy1
Class: PopUpButton
Menu: ("Edit"
  ((AddControlPoint) "Add CP (^p)" "Add a control point to a curve at the caret")
  ((DescribeCurve Selected) "DescribeSelected [G]" "Print a description of the selected object")
  ((DeleteControlPoint) "Delete CP (^P) [G]" "Delete the selected control point")
  ((AddHoles) "MakeHoles (^h) [G]" "Use the last selected closed trajectory as a fence and convert the remaining closed trajectories to holes in that fence")
  ((Weld) "Weld (^w) [G]" "Weld one or two selected open trajectories together")
  ((DeleteHoles) "UnMakeHoles (^H) [G]" "Replace fully selected composite outlines with simple outlines, one simple outline per element")
  ((SetOddWrap) "SetOddWrap [G]" "Set all selected outlines to display themselves with odd fill rule")
  ((ShowWrapRule) "ShowWrapRule" "Print value of wrap rule for selected object")
  ((SetNonZeroWrap) "SetNonZeroWrap [G]" "Set all selected outlines to display themselves with non-zero fill rule")
  ((OrientCW) "OrientCW [G]" "Orient all selected object clockwise")
  ((ShowOrientation) "ShowOrientation [G]" "Print value of orientation for selected object")
  ((OrientCCW) "OrientCCW [G]" "Orient all selected object counterclockwise")
  ((AddJoint) "AddJoint (^j)" "Add a joint to a curve at the caret")
  ((Reorient) "Reorient [G]" "Reverse orientation of all selected objects")
  ((SetCombine ORs NoOp) "Combine [G]" "Create an object which is the union of selected objects (straight line segments only for now)")
  ((ApplyAllDefaults) "ApplyAllDefaults [G]" "Apply current default looks to all selected objects")
  ((ShowAllDefaults) "ShowAllDefaults" "Print values of current defaults (hint: look in typescript)")
  ((StandardDefaults) "StandardDefaults" "Reset defaults to original values")
  ((Delete) "Delete (DEL) [G]" "Delete selected objects")
  ((HistoryTool) "HistoryTool" "Open or build a new history tool")
  )
MessageHandler: Gargoyle
Feedback: (
  (MouseMoved <SetCursor bullseye>)
  )) )

