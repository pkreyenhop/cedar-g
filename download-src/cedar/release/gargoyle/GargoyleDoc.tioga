Text T "Text" xerox/tiogafonts/Helvetica10I [10.0 0.0 178.8586 0.0 10.0 426.946][1 1.0] F 1.0 props: ( F ) ls: 1.2 pList: ( (ButtonData Poppy1
Class: PopUpButton
Menu: ("Text"
  ((AddText) "AddText [T]" "Add the current Tioga selection to the scene at the Caret")
  ((EditTiogaFill) "EditTiogaFill [G]" "Create a Tioga viewer containing a copy of the formatted nodes in the selected boxes")
  ((TiogaFillFromSelection) "FillBoxesFromSelection [GT]" "Fill the selected Gargoyle box objects with a copy of the formatted nodes in the Tioga selection")
  ((ScreenStyleKind) "StyleKindScreen [G]" "Set all selected boxes to screen style kind")
  ((ShowStyleKind) "ShowStyleKind [G]" "Show the style kind of the currently selected box")
  ((PrintStyleKind) "StyleKindPrint [G]" "Set all selected boxes to print style kind")
  ((DropShadowTenPercent) "DropShadowOn 0.10 [G]" "Add a drop shadow to each selected text object down and left by 0.10 of the text size")
  ((PrintDropShadow) "ShowDropShadow [G]" "Print drop shadow for the selected text object")
  ((DropShadowOff) "DropShadowOff [G]" "Remove drop shadows from the selected text objects")
  ((DropShadowFromSelection) "DropShadowFromSelection [GT]" "Add a drop shadow down and left to the selected text objects by the fraction of the text size in the Tioga selection")
  ((ShowDefaultTextLooks) "ShowDefaultLooks" "Print default text color and drop shadow")
  ((SetDefaultTextLooks) "MakeDefaultLooks [G]" "Set default text color and drop shadow from selected text")
  ((AmplifySpaceFromSelection) "AmplifySpaceFromSelection [GT]" "Set space amplification  of the selected text objects from the number in the Tioga selection")
  ((PrintAmplifySpace) "ShowAmplifySpace [G]" "Print space amplification value for the selected text object")
  ((SetAmplifySpace 1.0) "ResetAmplifySpace [G]" "Set the space amplification value to 1.0 for the selected text objects")
  ((SetNewlineFactor) "SetNewlineFactor [GT]" "Set all selected text string's line spacing to the factor in the Tioga selection (e.g. 1.2 for 20% line spacing)")
  ((ShowNewlineFactor) "ShowNewlineFactor [G]" "Show the line spacing factor of the currently selected text (e.g. 1.2 => 20% line spacing)")
  ((ConvertTextToSplines) "ConvertTextToSplines [G]" "From each selected text character, create an Outline object of the same shape")
  )
MessageHandler: Gargoyle
Feedback: (
  (MouseMoved <SetCursor bullseye>)
  )) )

