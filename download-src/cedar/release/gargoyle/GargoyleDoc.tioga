Text T "Debug" xerox/tiogafonts/Helvetica10I [10.0 0.0 401.0 0.0 10.0 394.0][1 1.0] F 1.0 props: ( F ) ls: 1.2 pList: ( (ButtonData Poppy1
Class: PopUpButton
Menu: ("Debug"
  ((ResetStatistics) "ResetStatistics" "Reset statistics for all timed operations")
  ((Statistics) "ShowStatistics" "Print on the typescript execution times for all timed operations that have been active since the last reset")
  ((PrintSelectedStatistic) "ShowSelectedStatistic" "Print on the typescript execution times for the timed operation named in the Tioga selection")
  ((TestGravity) "TestGravity" "Draw a gravity scatter-plot, where number of test points is the Tioga selection")
  ((CauseAnError) "CauseASignal" "Pop up a SIGNAL window to examine state")
  ((DrawBackgroundBox) "DrawBackgroundBox" "Draw a single box around all of the parts of selected objects that would be on the background plane during a drag")
  ((DrawOverlayBox) "DrawOverlayBox" "Draw a single box around all of the parts of selected objects that would be stationary on the overlay plane during a drag")
  ((DrawRubberBox) "DrawRubberBox" "Draw a single box around all of the parts of selected objects that would rubberband during a drag")
  ((DrawDragBox) "DrawDragBox" "Draw a single box around all of the parts of selected objects that would move rigidly during a drag")
  ((UserTraceOn) "UserTraceOn" "Start printing the procedure names Gargoyle is using to execute commands")
  ((UserTraceOff) "UserTraceOff" "Stop printing module names")
  ((PrintAllInput) "InputTraceOn" "Start printing the input tokens Gargoyle is receiving")
  ((ResetAllInput) "InputTraceOff" "Stop printing the input tokens Gargoyle is receiving")
  ((SceneState) "SceneState" "Show scene state")
  ((SceneBagState) "SceneBagState" "Show SceneBag state")
  ((DrawPolylines) "DrawPolylines" "Draw Polyline approximations to all closed trajectories")
  ((DrawTightBoxes) "DrawTightBoxes" "Draw tight-fitting bounding boxes around all selected slices")
  ((DrawBoundBoxes) "DrawBoundingBoxes" "Draw loose-fitting bounding boxes around all slices in scene")
  ((DrawSelectionBox) "DrawSelectionBox" "Draw a single box around all of the selected objects")
  )
MessageHandler: Gargoyle
Feedback: (
  (MouseMoved <SetCursor bullseye>)
  )) )

