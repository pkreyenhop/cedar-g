Text T "Groups" xerox/tiogafonts/Helvetica10I [10.0 0.0 477.0 0.0 10.0 442.0][1 1.0] F 1.0 props: ( F ) ls: 1.2 pList: ( (ButtonData Poppy1
Class: PopUpButton
Menu: ("Groups"
  ((Cluster) "Cluster (^c) [G]" "Turn the selected objects into a single object, for purposes of selection")
  ((ClusterAndFreeze) "ClusterAndFreeze [G]" "Turn the selected objects into a single object and prevent the parts from being moved individually")
  ((UnCluster) "UnCluster (^C) [G]" "Separate the selected cluster into its component objects")
  ((FreezeCluster) "FreezeCluster [G]" "Prevent the parts of the selected cluster(s) from being moved individually")
  ((ShowFrozen) "ShowFrozen [G]" "Prints whether the selected cluster is frozen or thawed")
  ((ThawCluster) "ThawCluster [G]" "Allows the parts of the selected cluster(s) to be moved individually")
  ((AddToGroup) "AddToGroup [GT]" "Add selected objects to the group named in the Tioga selection")
  ((PrintGroupsOfSelected) "ShowGroupsOfSelected [G]" "Print all the group names to which any selected object belongs")
  ((RemoveFromGroup) "RemoveFromGroup [GT]" "Remove selected objects from the group named in the Tioga selection")
  ((SelectGroup) "MatchGroup [T]" "Select all members of the group named in the Tioga selection")
  ((PrintAllGroups) "ShowAllGroups" "Print all the group names in the entire scene")
  ()
  )
MessageHandler: Gargoyle
Feedback: (
  (MouseMoved <SetCursor bullseye>)
  )) )

Text T "Select" xerox/tiogafonts/Helvetica10I [10.0 0.0 477.0 0.0 10.0 426.946][1 1.0] F 1.0 props: ( F ) ls: 1.2 pList: ( (ButtonData Poppy1
Class: PopUpButton
Menu: ("Select"
  ((CycleSelection Forward) "CycleSelection (^n)" "Select a different object near where the caret was when the last selection was made (cycling forward through the list)")
  ((SelectAll) "Select All (^d)" "Select every object in the scene")
  ((CycleSelection Backward) "UnCycleSelection (^N)" "Select a different object near where the caret was when the last selection was made (cycling backward through the list)")
  ((MoveSelection Forward) "SelectForward (^v)" "Select the object immediately in front of the currently selected object")
  ((DeselectAll) "Deselect All (^D)" "Deselect every object in the scene")
  ((MoveSelection Backward) "SelectBackward (^o)" "Select the object immediately behind the currently selected object")	
  ((MoveSelection ShrinkForward) "ShrinkForward (^V)" "Select the front child of the currently selected parent")
  ((MoveSelection Grow) "Grow (^i)" "Select the parent of the currently selected child")
  ((MoveSelection ShrinkBackward) "ShrinkBackward (^O)" "Select the back child of the currently selected parent")
  ((SelectCoincident) "Coincident" "Select every segment with coincident end points")
  ((SelectUnseeableSegs) "UnSeeableSegs" "Select every segment that can never be seen")
  ((SelectUnseeableObjs) "UnSeeableObj" "Select most complete objects that can never be seen")
  )
MessageHandler: Gargoyle
Feedback: (
  (MouseMoved <SetCursor bullseye>)
  )) )

