outlineParts: OutlineParts ¨ NARROW[parts];
outlineData: OutlineData ¨ NARROW[slice.data];
IF parts = NIL THEN FOR childList: LIST OF Slice ¨ outlineData.children, childList.rest UNTIL childList = NIL DO
