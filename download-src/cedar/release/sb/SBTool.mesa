sbTool: SBToolHandle _ NARROW[clientData];
sbTool.team _ CardModMouse[mouseButton, sbTool.team, sbTool.league.teamNms.size];
RePaintTeams[parent, clientData] };
TeamSet: Buttons.ButtonProc = {
sbTool: SBToolHandle _ NARROW[clientData];
dIndexStr: Rope.ROPE	_ ViewerTools.GetContents[sbTool.tVwr.dIndex];
SetLVwr[sbTool.tVwr.set, "done"] };
TeamDIndex: Buttons.ButtonProc = {
sbTool: SBToolHandle _ NARROW[clientData];
current: CARDINAL _ sbTool.league.teamStats[sbTool.team].dIndex;
current _ current + (SELECT mouseButton FROM
red		=>  1,
yellow	=>  0,
ENDCASE	=> (IF current=0 THEN 0 ELSE -1));
sbTool.league.teamStats[sbTool.team].dIndex _ current;
RePaintTeams[parent, clientData] };
name		=> rec.name	= m.team,
sse		=> rec.sse		= m.team,
dIndex	=> rec.dIndex	= m.dIndex,
ViewerTools.SetContents[sbTool.iVwr.dIndex, Convert.RopeFromCard[lastIndex]];
Scan[ parent, sbTool, mouseButton, dIndex] } };	-- too confusing
