path: PATH => {
IF PFSNames.IsADirectory[path] THEN paths _ LIST[path];
};
IO.PutRope[out, "( "];
IO.PutRope[out, ")"];
WITH CommanderOps.GetProp[cmd, $SearchRules] SELECT FROM
list: LIST OF REF => oldRules _ list;
ENDCASE;
Remove the extra LIST layer induced by Push
dir: ROPE _ Rope.Concat[FileNames.ResolveRelativePath[argv[i]], "$"];
dir _ FileNames.ConvertToSlashFormat[UFS.ExpandName[dir].fullUName];
dir _ Rope.Substr[dir, 0, Rope.Size[dir]-1];
IF tail = NIL THEN newRules _ tail _ LIST[FileNames.CurrentWorkingDirectory[]];
IO.PutF[cmd.err, " ---> PFS.DoInWDir[PATH[%g], Inner]; (shortName = %g)\n", [rope[PFS.RopeFromPath[tail.first]]], [rope[PFS.RopeFromPath[shortName]]]];
