GetToken: PROC[stream: STREAM, buffer: REF TEXT] 
RETURNS[state: State, index: INT, text: REF TEXT] ~ {
stateT: State _ null; indexT: INT _ 0; textT: REF TEXT _ NIL;
action: ActionType ~ { stateT _ state; indexT _ index; textT _ text; RETURN[TRUE] };
[] _ MapTokens[stream, buffer, action];
RETURN[stateT, indexT, textT];
};
