Inside/Outside Test
Based on code from Pat Hanrahan:
InsideContour: PUBLIC PROC [p: Pair, pairs: PairSequence] RETURNS [Border] ~ {
Based on code from Pat Hanrahan:
odd: BOOL _ FALSE;
dx1, dy1, zcross: REAL;
dx2: REAL _ pairs[pairs.length-1].x-p.x;
dy2: REAL _ pairs[pairs.length-1].y-p.y;
FOR n: NAT IN [0..pairs.length) DO
dx1 _ dx2;
dy1 _ dy2;
dx2 _ pairs[n].x-p.x;  
dy2 _ pairs[n].y-p.y;  
IF (dy1>0 AND dy2>0) OR
(dy1<0 AND dy2<0) OR
(dx1<0 AND dx2<0) THEN LOOP;	-- no chance to cross 
zcross _ dy2*dx1-dy1*dx2;  
IF zcross = 0.0 THEN RETURN[edge];  
IF (dy1>0 OR dy2>0) AND (zcross<0) # (dy1-dy2<0) THEN odd _ NOT odd;
ENDLOOP;
RETURN[IF odd THEN inside ELSE outside];
};
