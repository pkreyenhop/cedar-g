};
format3asi.i ¨ i;
RETURN [LOOPHOLE[format3asi]];
};

SetASI: PUBLIC PROCEDURE [
instruction: SPARCArchitecture.SPARCInstruction, asi: SPARCArchitecture.ASI] 
