blAddress: LONG POINTER TO RS6000Architecture.RS6000Instruction ~ 
@patchStruct.closureCaller.bl;
blCard: CARD32 ~ LOOPHOLE[blAddress];
offset: TargetArchitecture.Displacement ~
(blCard - patchStructCard) * BYTES[UNIT];

RETURN [offset];
};
