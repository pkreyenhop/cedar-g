GetSubOp31withOE: PUBLIC PROCEDURE [instruction: RS6000Architecture.RS6000Instruction] 
RETURNS [RS6000Architecture.SubOpFor31withOE] ~ {
formatGeneric: RS6000Architecture.Format2rArith ~ LOOPHOLE[instruction];
subOp: RS6000Architecture.SubOpFor31withOE ~ formatGeneric.subOp;

IF instruction.IsNullRS6000Instruction[] THEN {
