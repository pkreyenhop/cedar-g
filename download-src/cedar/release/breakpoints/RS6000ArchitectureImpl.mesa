ra: RS6000Architecture.Register]
RETURNS [RS6000Architecture.RS6000Instruction] ~ {
formatLoad: RS6000Architecture.FormatLoad ~ [
op: RS6000Architecture.Op.stm, rt: rs, ra: ra, d: offset];
instruction: RS6000Architecture.RS6000Instruction ~ LOOPHOLE[formatLoad];

RETURN [instruction];
