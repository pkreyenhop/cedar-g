RETURNS [RS6000Architecture.SubOpFor31withoutOE] ~ {
formatGeneric: RS6000Architecture.FormatCmp ~ LOOPHOLE[instruction];
subOp: RS6000Architecture.SubOpFor31withoutOE ~ formatGeneric.subOp;

