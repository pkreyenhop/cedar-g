instruction: RS6000Architecture.RS6000Instruction ~ LOOPHOLE[format2rui];

RETURN [instruction];
};

St: PUBLIC PROCEDURE [rs: RS6000Architecture.Register,
offset: RS6000Architecture.Disp16,
ra: RS6000Architecture.Register]
RETURNS [RS6000Architecture.RS6000Instruction] ~ {
formatLoad: RS6000Architecture.FormatLoad ~ [
