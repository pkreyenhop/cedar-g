GetSubOp3r63: PUBLIC PROCEDURE [instruction: RS6000Architecture.RS6000Instruction] 
RETURNS [RS6000Architecture.FSubOp3r63] ~ {
formatGeneric: RS6000Architecture.FormatFl3rArith ~ LOOPHOLE[instruction];
subOp: RS6000Architecture.FSubOp3r63 ~ formatGeneric.subOp;

IF instruction.IsNullRS6000Instruction[] THEN {
ERROR RS6000Architecture.NullRS6000Instruction;
};
RETURN [subOp];
