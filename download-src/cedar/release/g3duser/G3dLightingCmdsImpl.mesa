Shading Procedures
lt.lights[lt.activeLight] _ RebuildLight[lt.lights[lt.activeLight], lt.materials[lt.activeMaterial]];
rgb.R _ NARROW[lt.lightColorSlider1.value];
rgb.G _ NARROW[lt.lightColorSlider2.value];
rgb.B _ NARROW[lt.lightColorSlider3.value];
