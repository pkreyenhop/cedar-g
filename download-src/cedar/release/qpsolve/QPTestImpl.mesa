init[8] _  MAX[gapWidth,
				skipWidth-(firstColWidth+secondColWidth)/2,
				headingWidth-(firstColWidth+secondColWidth)];
init[12] _ MAX[headingWidth, init[8]+(firstColWidth+secondColWidth)];
init[1] _ init[2] _ firstColWidth/2;
init[5] _ init[6] _ secondColWidth/2;
init[3] _ init[4] _ init[8]/2;
init[10] _ init[11] _ init[12]/2;
init[13] _ init[2]+init[8]+init[5];
