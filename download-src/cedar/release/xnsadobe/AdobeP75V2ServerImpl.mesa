UProc50: PROC [h: CrRPC.Handle, s: CrRPC.STREAM] RETURNS [res: SetOfARs] ~ {
{
length81: CARDINAL ~ CrRPC.GetCard16[s];
res ¨  NEW[SetOfARsObject[length81]];
FOR i80: CARDINAL IN [0..length81) DO
res.body[i80].startValue ¨ CrRPC.GetCard32[s];
