FOR i90: CARDINAL IN [0..length91) DO
res.seq[i90].tag ¨ CrRPC.GetRope[s];
res.seq[i90].item ¨ CrRPC.GetCard16[s];
ENDLOOP;
};
};

MProc88: PROC [h: CrRPC.Handle, s: CrRPC.STREAM, val: KeyedPossibilities] ~ {
CrRPC.PutCard16[s, val.length];
FOR i92: CARDINAL IN [0..val.length) DO
CrRPC.PutCard16[s, val.seq[i92].keyedDependency];
MProc93[h, s, val.seq[i92].enumRecs];
ENDLOOP;
};

MProc93: PROC [h: CrRPC.Handle, s: CrRPC.STREAM, val: EnumeratedSequence] ~ {
CrRPC.PutCard16[s, val.length];
FOR i94: CARDINAL IN [0..val.length) DO
CrRPC.PutRope[s, val.seq[i94].tag];
CrRPC.PutCard16[s, val.seq[i94].item];
ENDLOOP;
};


