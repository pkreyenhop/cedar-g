GetFindNearestsOfKindreturn: PUBLIC PROC[h: Handle] RETURNS [res: LB.FindNearestsOfKindreturn] = {
tag: LB.ReturnCodes;
tag _ GetReturnCodes[h];
SELECT tag FROM
EError => {
v: REF EError LB.FindNearestsOfKindreturnObject _ NEW[EError LB.FindNearestsOfKindreturnObject];
v.EErrorValue _ GetErrorType[h];
res _ v;
};
iluSuccess => {
