debugMsgs: BOOL _ FALSE;

SetDebugMsgs: PROC [i: INT] RETURNS [prev: INT] ~ {
prev _ IF debugMsgs THEN 1 ELSE 0;
debugMsgs _ (i # 0);
};

PrintDebugMsgInner: PROC [s: CARD32] ~ TRUSTED MACHINE CODE { "XR_ConsoleMsg" };

XRCharStarFromRope: PROC [r: ROPE] RETURNS [CARD32] ~ TRUSTED MACHINE CODE { "XR_CharStarFromRope" };

PrintDebugMsg: PROC [r: ROPE] ~ {
s: CARD32 _ XRCharStarFromRope[r];
PrintDebugMsgInner[s];
};
