Exit[vc];
vc.baseClass.DontCorrect[vc.base, action, saveCP];
Enter[vc]; {ENABLE UNWIND => Exit[vc];
vc.baseClass.SetXY[vc.base, cp]};
Exit[vc]}
ELSE vc.baseClass.DontCorrect[vc.base, action, saveCP];
RETURN};

