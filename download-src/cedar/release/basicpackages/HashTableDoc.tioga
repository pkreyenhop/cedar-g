_ histDist _ FALSE
_ reportStream _ &stdout[]
_ &sqrt05 _ RealFns.SqRt[0.5]
_ &sqrt20 _ RealFns.SqRt[2.0]
_ &e _ RealFns.Exp[1.0]

{ densityLimits: REALList _ LIST[0.5, &sqrt05, 1.0, &sqrt20, 2.0]; NULL}
{ growthFactors: REALList _ LIST[&sqrt20, 2.0, &e, 3.0, 4.0, 6.0]; NULL}

{ TestR: PROC = {FOR dls: REALList _ densityLimits, dls.rest WHILE dls # NIL DO FOR gfs: REALList _ growthFactors, gfs.rest WHILE gfs # NIL DO Report[RRhtSub[dls.first, gfs.first, selectedPrime]] ENDLOOP; IO.PutRope[reportStream, "\n"]; ENDLOOP}; NULL}

{ TestS: PROC = {FOR dls: REALList _ densityLimits, dls.rest WHILE dls # NIL DO FOR gfs: REALList _ growthFactors, gfs.rest WHILE gfs # NIL DO Report[SRhtSub[dls.first, gfs.first, selectedPrime]] ENDLOOP; IO.PutRope[reportStream, "\n"]; ENDLOOP}; NULL}

