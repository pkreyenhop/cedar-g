Mush: PROC [p: PROCESS] RETURNS [c: CARDINAL  _ 0] ~ INLINE {
N: INT ~ SIZE[PROCESS]/SIZE[CARDINAL];
T: TYPE ~ ARRAY [1..N] OF CARDINAL;
a: T;

a _ LOOPHOLE[p, T];
FOR i: INT IN [1..N] DO
c _ Basics.BITXOR[c, a[i]];
ENDLOOP;
RETURN [c];
};

