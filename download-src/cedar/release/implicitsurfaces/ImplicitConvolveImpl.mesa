Types and Constants
Public Procedures
t: Triple м G3dVector.Sub[p.origin, G3dPlane.ProjectPointToPlane[q, pln]];
If obviate GetImageProjection scale:
p.xAxis м G3dVector.Mul[xAxis, p.scale];
p.yAxis м G3dVector.Mul[yAxis, p.scale];
p.normal м G3dVector.Mul[normal, p.scale];
If using major plane projection in 2d:
p.major м G3dPlane.GetMajorPlane[p.plane];
p.xAxis м G3dPlane.ProjectPointToMajorPlane[p.xAxis, p.major];
p.yAxis м G3dPlane.ProjectPointToMajorPlane[p.yAxis, p.major];
 [Artwork node; type 'Artwork on' to command tool] 
If using projection to major plane:
v: Pair м G3dPlane.ProjectPointToMajorPlane[G3dVector.Sub[q, p.origin], p.major];
xy м [G2dVector.Dot[v, p.Axis], G2dVector.Dot[v, p.yAxis]];
IF p.oneSided AND distance < 0.0 THEN RETURN[0.0];
Out[IO.PutFR["value = %g\n", IO.real[v]]];
Surface normals are presumed to point towards the outside of the convex solid.
Shaded Display
local storage to avoid accumulation of "normalization" if repeated calls to SetImagePath:
Line Drawing

Debug
PrintMatrix: PROC [matrix: G3dMatrix.Matrix, name: ROPE м NIL] ~ {
IF out = NIL OR matrix = NIL THEN RETURN;
IF name # NIL THEN IO.PutF[out, "%g\n", IO.rope[name]];
FOR i: NAT IN [0..3] DO
Out[IO.PutFR[out, "%6.3f\t%6.3f\t%6.3f\t%6.3f\n",
IO.real[matrix[i][0]], IO.real[matrix[i][1]], IO.real[matrix[i][2]], IO.real[matrix[i][3]]]];
ENDLOOP;
};

PrintPrimitive: PROC [p: Primitive] ~ {
Out[IO.PutFR[out, "nVertices = %g\n", IO.int[p.nVertices]]];
};
Start Code
SetImagePath: PUBLIC PROC [p: Primitive, path: PairList, filter: BOOL м TRUE] ~ {
p.path м ScalePairList[CopyPairList[path], p.scale];
SELECT p.nVertices FROM
> 2 => { -- this is an incredibly awkward way to smooth shade a polygon, but . . .
Trajectory: TYPE ~ ImagerPath.Trajectory;
TrajectoryFromList: PROC [pairs: PairList] RETURNS [t: Trajectory] ~ {
t м ImagerPath.MoveTo[pairs.first];
FOR l: PairList м pairs.rest, l.rest WHILE l # NIL DO
t м ImagerPath.LineTo[t, l.first];
ENDLOOP;
};
Bit: PROC [context: Context] ~ {
Imager.SetGray[context, 1];
Imager.MaskRectangle[context, [0, 0, 1, 1]];					-- grotesque: fix minimum
Imager.MaskRectangle[context, [p.res.x-1, p.res.y-1, 1, 1]];	-- grotesque: fix maximum
Imager.MaskFillTrajectory[context, TrajectoryFromList[p.path]];
};
bit: SampleMap м ImagerSample.ZeroOrigin[
ImagerMaskCapture.CaptureBitmap[Bit, ImagerTransformation.Rotate[-90.0]]];
box: ImagerSample.Box м [[0, 0], [p.res.y, p.res.x]];
map: SampleMap м ImagerSample.ObtainScratchMap[box, 8];
size: ImagerSample.Vec м SF.Min[ImagerSample.GetSize[map], ImagerSample.GetSize[bit]];
line: ImagerSample.SampleBuffer ~ ImagerSample.ObtainScratchSamples[size.f];
ImagerSample.Clear[map];
FOR y: NAT IN [1..size.s-1) DO -- avoid "fix" points
ImagerSample.GetSamples[bit, [y, 0],, line, 0, size.f];
FOR x: NAT IN [0..size.f) DO
line.samples[x] м IF line.samples[x] = 1 THEN 255 ELSE 0;
ENDLOOP;
ImagerSample.FlipSamples[line]; -- ever more ugliness
ImagerSample.PutSamples[map, [y, 0],, line, 0, size.f];
ENDLOOP;
IF p.intensities # NIL THEN {
same: BOOL м TRUE;
max: REAL м p.intensities[0];
FOR i: INT IN [1..p.intensities.length) DO
IF max # p.intensities[i] THEN {max м MAX[max, p.intensities[i]]; same м FALSE};
ENDLOOP;
p.intensity м max*p.intensity; -- normalize
FOR i: INT IN [0..p.intensities.length) DO p.intensities[i]мp.intensities[i]/max; ENDLOOP;
};
IF filter THEN CtFilter.ResampleMap[map, box, box, p.filter];
p.image м CtBasic.PixelArrayFromSampleMap[map];
ImagerSample.ReleaseScratchSamples[line];
ImagerSample.ReleaseScratchMap[map];
};
2 => {
pairs: PairList м path;
box: ImagerSample.Box м [[0, 0], [1, p.res.x]];
map: SampleMap м ImagerSample.ObtainScratchMap[box, 8];
line: ImagerSample.SampleBuffer ~ ImagerSample.ObtainScratchSamples[p.res.x];
FOR x: INT IN [0..p.res.x) DO
line.samples[x] м IF x IN [pairs.first.x..pairs.rest.first.x] THEN 255 ELSE 0;
ENDLOOP;
IF p.intensities # NIL AND p.intensities.length = 2 THEN
FOR x: INT IN [0..p.res.x) DO
a: REAL м REAL[x]/REAL[p.res.x-1];
factor: REAL м p.intensities[1]+a*(p.intensities[1]-p.intensities[0]);
line.samples[x] м Real.Round[factor*REAL[line.samples[x]]];
ENDLOOP;
ImagerSample.PutSamples[map, [0, 0],, line, 0, p.res.x];
IF filter THEN CtFilter.ResampleMap[map, box, box, p.filter];
ImagerSample.GetSamples[map,,, p.buffer м ImagerSample.NewSamples[p.res.x]];
ImagerSample.ReleaseScratchSamples[line];
ImagerSample.ReleaseScratchMap[map];
};
1 => NULL;
ENDCASE;
};

polygon => {
o: Triple м GetPoint[p, 0];
n: Triple м p.normal м G3dPolygon.PolygonNormal[p.points, p.indices, TRUE];
x: Triple м G3dVector.Unit[G3dVector.Ortho[n]];
y: Triple м G3dVector.Unit[G3dVector.Cross[n, x]];
m: Matrix м p.xform м G3dMatrix.Invert[G3dMatrix.MakeFromTriad[x, y, n, o]];
mm: G2dBasic.Box м MinMaxOfPairs[PairsFromXformedPrimitive[p]];
dif: Pair м G2dVector.Add[[4*p.extent, 4*p.extent], G2dVector.Sub[mm.max, mm.min]];
p.scale м MIN[REAL[p.res.x]/dif.x, REAL[p.res.y]/dif.y];
p.plane м G3dPlane.FromPointAndNormal[o, n];
p.xform м m м G3dMatrix.Scale[p.xform, p.scale, p.xform];
mm м MinMaxOfPairs[PairsFromXformedPrimitive[p]];
p.move м [2*p.filter.support-mm.min.x, 2*p.filter.support-mm.min.y];
p.xform м G3dMatrix.Translate[m, [p.move.x, p.move.y, 0], m];
};

PairsFromXformedPrimitive: PROC [p: Primitive] RETURNS [pairs: PairList] ~ {
FOR n: NAT IN [0..p.nVertices) DO
pairs м CONS[XYFrom3d[GetPoint[p, n], p], pairs];
ENDLOOP;
};

XYFrom3d: PROC [point: Triple, p: Primitive] RETURNS [pp: Pair] ~ {
pp.x м point.x*p.xform[0][0]+point.y*p.xform[1][0]+point.z*p.xform[2][0]+p.xform[3][0];
pp.y м point.x*p.xform[0][1]+point.y*p.xform[1][1]+point.z*p.xform[2][1]+p.xform[3][1];
};
scratchReals: ARRAY [0..9] OF RealSequence м ALL[NIL];

ObtainReals: ENTRY PROC [strength: REAL] RETURNS [reals: RealSequence] ~ {
FOR i: NAT IN [0..9] DO
IF (reals м scratchReals[i]) # NIL THEN {scratchReals[i] м NIL; EXIT};
ENDLOOP;
IF reals = NIL THEN reals м NEW[G3dBasic.RealSequenceRep[4]];
reals[0] м reals[1] м reals[2] м strength;
reals[3] м 0.0;
reals.length м 4;
};

ReleaseReals: ENTRY PROC [reals: RealSequence] ~ {
FOR i: NAT IN [0..9] DO IF scratchReals[i] = NIL THEN {scratchReals[i] м reals; EXIT}; ENDLOOP;
};

context: G3dRender.Context;

ConvolvePrimitive: PUBLIC PROC [primitive: Primitive, intensity: REAL,res:IntegerPairм[50,50]]~{
For polygons with differing vertex intensities
FancyPatch: TYPE ~ G3dRenderWithPixels.FancyPatch;
MakeMap: PROC RETURNS [SampleMap] ~ {
patch: REF FancyPatch м NEW[G3dRenderWithPixels.FancyPatch[primitive.points.length]];
IF context = NIL THEN context м G3dRender.CreateUndisplayedContext[, res.x, res.y, gray];
G3dRender.SetAntiAliasing[context, TRUE];
G3dSortandDisplay.ValidateContext[context];
FOR n: NAT IN [0..primitive.points.length) DO
pair: Pair м G3dMatrix.TransformD[p.points[n], p.xform];
patch[n] м [pair.x, res.y-pair.y, ObtainReals[p.strengths[n]]];
ENDLOOP;
G3dRenderWithPixels.FillInConstantBackGround[context, [0, 0, 0], 0];
G3dRenderWithPixels.RealFancyTiler[context, patch];
FOR n: NAT IN [0..primitive.points.length) DO ReleaseReals[patch[n].val]; ENDLOOP;
RETURN[context.pixels[0]];
};
m: SampleMap;
SetGeometry[primitive, intensity, res];
m м MakeMap[];
CtFilter.ResampleMap[map,ImagerSample.GetBox[m], ImagerSample.GetBox[m], primitive.filter];
primitive.image м CtBasic.PixelArrayFromSampleMap[m];
};

ProjectToMajorPlane: PROC [p: Triple, plane: Quad, majorPlane: MajorPlane] RETURNS [Pair]
~ {
normal: Triple ~ [plane.x, plane.y, plane.z];
distance: REAL ~ G3dVector.Dot[p, normal]+plane.w;
RETURN[SELECT majorPlane FROM
xy =>			G2dVector.Sub[[p.x, p.y], G3dVector.Mul[[plane.x, plane.y], distance]];
xz =>			G2dVector.Sub[[p.x, p.z], G3dVector.Mul[[plane.x, plane.z], distance]];
ENDCASE =>	G2dVector.Sub[[p.y, p.z], G3dVector.Mul[[plane.y, plane.z], distance]]];
};

IntersectPolygonWithRay: PROC RETURNS [list: LIST OF REAL] ~ {
normal: Triple м G3dVector.Ortho[p.twist.axis.axis];
plane: Quad м G3dPlane.FromPointAndNormal[p.twist.axisbase, normal];
FOR n: NAT IN [0..p.nVertices) DO
p0: Triple м GetPoint[p, n];
p1: Triple м GetPoint[p, (n+1) MOD p.nVertices];
d0: REAL м G3dPlane.DistanceToPoint[p0, plane]; 
d1: REAL м G3dPlane.DistanceToPoint[p1, plane]; 
IF d0*d1 < 0.0 THEN {
a0: REAL м ABS[d0];
a1: REAL м ABS[d1];
t: Triple м G3dVector.Combine[p0, a1/(a0+a1), p1, a0/(a+a1)];
};
ENDLOOP;
};

