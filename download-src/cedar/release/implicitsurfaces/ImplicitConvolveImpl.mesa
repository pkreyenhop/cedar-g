
DIRECTORY Commander, CtBasic, CtFilter, CtMod, G2dBasic, G2dScan, G2dVector, G3dBasic, G3dDraw, G3dMatrix, G3dPlane, G3dPolygon, G3dVector, Imager, ImagerColor, ImagerSample, ImplicitConvolve, ImplicitDebug, ImplicitDesign, IO, Real, RealFns, Rope, ImagerPath, ImagerMaskCapture, ImagerTransformation, SF;

ImplicitConvolveImpl: CEDAR PROGRAM
IMPORTS Commander, CtBasic, CtFilter, CtMod, G2dBasic, G2dScan, G2dVector, G3dDraw, G3dPlane, G3dPolygon, G3dVector, Imager, ImagerSample, ImplicitDebug, ImplicitDesign, IO, Real, RealFns
EXPORTS ImplicitConvolve

~ BEGIN
Filter:					TYPE ~ CtFilter.Filter;
Box:					TYPE ~ G3dBasic.Box;
Pair:					TYPE ~ G3dBasic.Pair;
IntegerPair:			TYPE ~ G3dBasic.IntegerPair;
Quad:					TYPE ~ G3dBasic.Quad;
RealSequence:		TYPE ~ G3dBasic.RealSequence;
Triple:				TYPE ~ G3dBasic.Triple;
TripleSequence:		TYPE ~ G3dBasic.TripleSequence;
DrawType:			TYPE ~ G3dDraw.DrawType;
Matrix:				TYPE ~ G3dMatrix.Matrix;
Viewport:				TYPE ~ G3dMatrix.Viewport;
Context:				TYPE ~ Imager.Context;
RGB:					TYPE ~ ImagerColor.RGB;
SampleMap:			TYPE ~ ImagerSample.SampleMap;
PairList:				TYPE ~ ImplicitConvolve.PairList;
Primitive:				TYPE ~ ImplicitConvolve.Primitive;
PrimitiveList:		TYPE ~ ImplicitConvolve.PrimitiveList;
PrimitiveRep:		TYPE ~ ImplicitConvolve.PrimitiveRep;
ThicknessRep:		TYPE ~ ImplicitConvolve.ThicknessRep;
Twist:					TYPE ~ ImplicitConvolve.Twist;
ROPE:					TYPE ~ Rope.ROPE;

defaultFilter:			Filter м CtFilter.FilterFind["cubic"];
debug:				BOOL м FALSE;
MakePrimitive: PUBLIC PROC [
points:		TripleSequence,
extent:		REAL м 0.1,
thickness:	REAL м 0.0,
intensity:		REAL м 1.0,
intensities:	RealSequence,
indices:		LIST OF INTEGER,
res:			IntegerPair м [50, 50],
color:			RGB м [1.0, 1.0, 1.0],
twist:			Twist м []]
RETURNS [p: Primitive]
~ {
p м NEW[PrimitiveRep м [
points: points,
extent: extent,
intensity: intensity,
intensities: intensities,
res: res,
color: color,
twist: twist,
nVertices: points.length,
filter: defaultFilter
]];
IF thickness # 0 THEN p.thickness м NEW[ThicknessRep м [value: thickness]];
IF p.twist.p0 = p.twist.p1 THEN p.twist.tw0 м p.twist.tw1 м 0.0;
IF indices # NIL THEN {
nVerts: NAT м 0;
FOR l: LIST OF INTEGER м indices, l.rest WHILE l # NIL DO nVerts м nVerts+1; ENDLOOP;
p.indices м NEW[G2dBasic.NatSequenceRep[nVerts]];
FOR n: NAT IN [0..p.indices.length м nVerts) DO
p.indices[n] м indices.first;
indices м indices.rest;
ENDLOOP;
p.nVertices м nVerts;
};
SetGeometry[p];
};

GetBounds: PROC [p: Primitive] RETURNS [b: Box] ~ {
extentF: REAL м p.extent*2.0*1.0*1.8; -- usual extent factor*fudge*sqrt(3) (if on diag)
huge: REAL ~ Real.LargestNumber;
b м [[huge, huge, huge], [-huge, -huge, -huge]];
FOR n: NAT IN [0..p.nVertices) DO
t: Triple м GetPoint[p, n];
b.min м [MIN[b.min.x, t.x], MIN[b.min.y, t.y], MIN[b.min.z, t.z]];
b.max м [MAX[b.max.x, t.x], MAX[b.max.y, t.y], MAX[b.max.z, t.z]];
ENDLOOP;
b.min м G3dVector.Sub[b.min, [extentF, extentF, extentF]];
b.max м G3dVector.Add[b.max, [extentF, extentF, extentF]];
};

GetPoint: PUBLIC PROC [p: Primitive, n: INTEGER] RETURNS [Triple] ~ {
RETURN[p.points[IF p.indices # NIL THEN p.indices[n] ELSE n]];
};

SetGeometry: PUBLIC PROC [p: Primitive] ~ {
NearnessAccelerator: PROC [p0, p1: Triple] RETURNS [v: Triple, w: REAL] ~ {
v м G3dVector.Sub[p1, p0];
IF (w м v.x*v.x+v.y*v.y+v.z*v.z) # 0.0 THEN v м [v.x/w, v.y/w, v.z/w];
};
SELECT p.nVertices FROM
> 2 => {
PairsFromProjection: PROC RETURNS [list: PairList] ~ {
FOR n: NAT IN [0..p.nVertices) DO
q: Triple м GetPoint[p, n];
t: Triple м G3dPlane.ProjectPointToPlane[q, pln];
pp: Pair м [G3dVector.Dot[t, xAxis], G3dVector.Dot[t, yAxis]];
list м CONS[[G3dVector.Dot[t, xAxis], G3dVector.Dot[t, yAxis]], list];
IF debug THEN {
Out[IO.PutFR["q = (%g, %g, %g\n", IO.real[q.x], IO.real[q.y], IO.real[q.z]]];
Out[IO.PutFLR["t = (%g, %g, %g), p = (%g, %g)\n",
LIST[IO.real[t.x], IO.real[t.y], IO.real[t.z], IO.real[pp.x], IO.real[pp.y]]]];
};
ENDLOOP;
};
normal: Triple м p.normal м G3dPolygon.PolygonNormal[p.points, p.indices, TRUE];
pln: G3dPlane.Plane м G3dPlane.FromPointAndNormal[GetPoint[p, 0], normal];
plane: Quad м p.plane м [pln.x, pln.y, pln.z, pln.w];
xAxis: Triple м p.xAxis м IF p.twist.tw0 # 0 OR p.twist.tw1 # 0	-- x axis in the plane
THEN G3dVector.Unit[G3dVector.Sub[p.twist.p1, p.twist.p0]]
ELSE G3dVector.Ortho[normal];
yAxis: Triple м p.yAxis м G3dVector.Cross[xAxis, normal];
origin: Triple м G3dVector.Mul[normal, -p.plane.w];				-- origin of plane
mm: G2dBasic.Box м MinMaxOfPairs[PairsFromProjection[]];		-- 2d image bounds
min: Pair м G2dVector.Sub[mm.min, [2*p.extent, 2*p.extent]];		-- extent margin
p.size м G2dVector.Add[[4*p.extent, 4*p.extent], G2dVector.Sub[mm.max, mm.min]];
p.scale м MIN[REAL[p.res.x]/p.size.x, REAL[p.res.y]/p.size.y];
p.origin м G3dVector.Add[origin, G3dVector.Combine[xAxis, min.x, yAxis, min.y]];
IF debug THEN {
PrintTriple["xAxis", p.xAxis];
PrintTriple["yAxis", p.yAxis];
Out[IO.PutFLR["size: (%g, %g), scale: %g, extent = %g\n",
LIST[IO.real[p.size.x], IO.real[p.size.y], IO.real[p.scale], IO.real[p.extent]]]];
Out[IO.PutFR["min: (%g, %g)\n", IO.real[min.x], IO.real[min.y]]];
PrintTriple["origin", p.origin];
Out[IO.PutFLR["plane: (%g, %g, %g, %g)\n",
LIST[IO.real[p.plane.x], IO.real[p.plane.y], IO.real[p.plane.z], IO.real[p.plane.w]]]];
};
IF p.twist.tw0 # 0 OR p.twist.tw1 # 0 THEN {
p.p0x м G3dVector.Add[
p.twist.p0, G3dVector.Project[G3dVector.Sub[p.origin, p.twist.p0], xAxis]];
p.p1x м G3dVector.Add[p.p0x, G3dVector.Mul[xAxis, p.size.x]];
p.h м G3dVector.Dot[yAxis, G3dVector.Sub[p.twist.p0, p.origin]];
[p.accV, p.accW] м NearnessAccelerator[p.twist.p0, p.twist.p1];
};
};
2 => {
p0: Triple м GetPoint[p, 0];
p1: Triple м GetPoint[p, 1];
axis: Triple м G3dVector.Unit[G3dVector.Sub[p1, p0]];
p.origin м p0 м G3dVector.ScaleRay[[p0, axis], -2.0*p.extent];
p1 м G3dVector.ScaleRay[[p1, axis],  2.0*p.extent];
[p.accV, p.accW] м NearnessAccelerator[p0, p1];
p.res.y м 1;
p.scale м REAL[p.res.x]/G3dVector.Distance[p1, p0];
IF debug THEN
Out[IO.PutFR["segment, scale: %g, extent = %g\n", IO.real[p.scale], IO.real[p.extent]]];
};
1 => NULL;
ENDCASE => ERROR;
p.recipExtent м 1.0/p.extent;
p.filter.support м p.filter.blur м p.scale*p.extent;
p.bounds м GetBounds[p];
};

GetImageProjection: PUBLIC PROC [q: Triple, p: Primitive]
RETURNS [xy: Pair, distance: REAL]
~ {
IF p.twist.tw0 # 0 OR p.twist.tw1 # 0
THEN {
a: REAL м G3dVector.Dot[p.accV, G3dVector.Sub[q, p.twist.p0]];
tw: REAL м p.twist.tw0+a*(p.twist.tw1-p.twist.tw0);
n: Triple м G3dVector.Combine[p.normal, RealFns.Cos[tw], p.yAxis, RealFns.Sin[tw]];
y: Triple м G3dVector.Cross[p.xAxis, n];
o: Triple м G3dVector.Add[p.twist.p0, G3dVector.Mul[p.accV, a*p.accW]];
plane: G3dPlane.Plane м G3dPlane.FromPointAndNormal[o, n, TRUE];
qq: Triple м G3dPlane.ProjectPointToPlane[q, plane];
xy.x м G3dVector.Distance[o, p.p0x];
xy.y м p.h+G3dVector.Dot[G3dVector.Sub[qq, o], y];
IF NOT p.distanceSet THEN p.distance м q.x*plane.x+q.y*plane.y+q.z*plane.z+plane.w;
}
ELSE  {
v: Triple м G3dVector.Sub[q, p.origin];
xy м [G3dVector.Dot[v, p.xAxis], G3dVector.Dot[v, p.yAxis]];
IF NOT p.distanceSet
THEN p.distance м q.x*p.plane.x+q.y*p.plane.y+q.z*p.plane.z+p.plane.w;
};
p.distanceSet м TRUE;
distance м p.distance;
xy м G2dVector.Mul[xy, p.scale];
};

MinMaxOfPairs: PROC [pairs: PairList] RETURNS [b: G2dBasic.Box] ~ {
b м [[Real.LargestNumber, Real.LargestNumber], [-Real.LargestNumber, -Real.LargestNumber]];
FOR l: PairList м pairs, l.rest WHILE l # NIL DO
b.min м [MIN[b.min.x, l.first.x], MIN[b.min.y, l.first.y]];
b.max м [MAX[b.max.x, l.first.x], MAX[b.max.y, l.first.y]];
ENDLOOP;
};

ValueOfPrimitive: PUBLIC PROC [q: Triple, p: Primitive] RETURNS [v: REAL м 0.0] ~ {
distance, intensity: REAL м 1.0;
IF NOT p.active THEN RETURN;
IF q.x < p.bounds.min.x OR q.y < p.bounds.min.y OR q.z < p.bounds.min.z OR
q.x > p.bounds.max.x OR q.y > p.bounds.max.y OR q.z > p.bounds.max.z THEN RETURN;
SELECT p.nVertices FROM
> 2 => IF p.image # NIL THEN {
xy: Pair;
ix, iy: NAT;
[xy, distance] м GetImageProjection[q, p];
IF xy.x < 0 OR xy.y < 0 OR xy.x >= p.res.x OR xy.y >= p.res.y THEN RETURN[0.0];
IF NOT p.interp THEN {ix м Real.Round[xy.x]; iy м Real.Round[xy.y]};
intensity м (1.0/255.0)*(IF p.interp
THEN CtMod.BiLerpReal[p.image, xy.x, xy.y]
ELSE REAL[p.image[iy][ix]]);
IF p.thickness # NIL AND p.thickness.array # NIL THEN
distance м MAX[0.0, ABS[distance]-p.thickness.value*(0.5/255.0)*(IF p.interp
THEN CtMod.BiLerpReal[p.thickness.array, xy.x, xy.y]
ELSE REAL[p.thickness.array[iy][ix]])];
};
2 => IF p.buffer # NIL THEN {
Lerp: PROC [buffer: ImagerSample.SampleBuffer, x: REAL] RETURNS [l: REAL] ~ {
ix0, ix1: INT16 м Real.Floor[x];
l м buffer[ix0];
IF (ix1 м ix0+1) < buffer.length THEN l м l+(x-ix0)*(buffer[ix1]-l);
};
a: REAL м G3dVector.Dot[p.accV, G3dVector.Sub[q, p.origin]];
IF a NOT IN (0.0..1.0) THEN RETURN[0.0];
distance м G3dVector.Distance[q, G3dVector.ScaleRay[[p.origin, p.accV], a*p.accW]];
intensity м (1.0/255.0)*(IF p.interp
THEN Lerp[p.buffer, 0.5+(p.res.x-1)*a]
ELSE REAL[p.buffer[Real.Round[0.5+(p.res.x-1)*a]]]);
};
1 => distance м G3dVector.Distance[q, GetPoint[p, 0]];
ENDCASE => ERROR;
v м p.valueScale*intensity*p.filter.evalProc[distance*p.recipExtent];
};

ValueOfPrimitives: PUBLIC PROC [q: Triple, primitives: PrimitiveList]
RETURNS [v: REAL м 0.0]
~ {
FOR l: PrimitiveList м primitives, l.rest WHILE l # NIL DO
v м v+ValueOfPrimitive[q, l.first];
ENDLOOP;
};

ConvolvePrimitive: PUBLIC PROC [p: Primitive, filter: BOOL] ~ {
IF p.nVertices <= 2 THEN p.res.y м 1;
SELECT p.nVertices FROM
> 2 => {
pairs: PairList м NIL;
FOR n: NAT IN [0..p.nVertices) DO	-- ignore twist when making image
v: Triple м G3dVector.Sub[GetPoint[p, n], p.origin];
pairs м CONS[[G3dVector.Dot[v, p.xAxis], G3dVector.Dot[v, p.yAxis]], pairs];
ENDLOOP;
SetImagePath[p, pairs, filter];
};
2 => {
x0: REAL м 2.0*p.scale*p.extent;
x1: REAL м REAL[p.res.x-1]-2.0*p.scale*p.extent;
SetImagePath[p, LIST[[x0, 0], [x1, 0], [x1, 1], [x0, 1]], filter];
};
ENDCASE;
};

GetTwisted: PUBLIC PROC [p: Primitive, q: Triple] RETURNS [Triple] ~ {
IF p.twist.tw0 # 0 OR p.twist.tw1 # 0
THEN {
a: REAL м G3dVector.Dot[p.accV, G3dVector.Sub[q, p.twist.p0]];
tw: REAL м p.twist.tw0+a*(p.twist.tw1-p.twist.tw0);
o: Triple м G3dVector.Add[p.twist.p0, G3dVector.Mul[p.accV, a*p.accW]];
D: Triple м G3dVector.Sub[q, o];
n: Triple м G3dVector.SameLength[D, G3dVector.Cross[D, p.xAxis]];
v: Triple м G3dVector.Combine[D, RealFns.Cos[tw], n, -RealFns.Sin[tw]];
RETURN[G3dVector.Add[o, v]];
}
ELSE RETURN[q];
};

NActivePrimitives: PUBLIC PROC [primitives: PrimitiveList] RETURNS [i: INTEGER м 0] ~ {
FOR l: PrimitiveList м primitives, l.rest WHILE l # NIL DO IF l.first.active THEN i м i+1; ENDLOOP;
};

SetIDs: PUBLIC PROC [list: LIST OF PrimitiveList, startID: INTEGER м 0] ~ {
FOR l: LIST OF PrimitiveList м list, l.rest WHILE l # NIL DO
FOR p: PrimitiveList м l.first, p.rest WHILE p # NIL DO
IF p.first.id = -1 THEN {p.first.id м startID; startID м startID+1};
ENDLOOP;
ENDLOOP;
};

CombinePrimitives: PUBLIC PROC [list: LIST OF PrimitiveList] RETURNS [ret: PrimitiveList] ~ {
FOR l: LIST OF PrimitiveList м list, l.rest WHILE l # NIL DO
FOR p: PrimitiveList м l.first, p.rest WHILE p # NIL DO
IF p.first # NIL THEN ret м CONS[p.first, ret]
ENDLOOP;
ENDLOOP;
};

InvalidateDistance: PUBLIC PROC [primitives: PrimitiveList] ~ {
FOR l: PrimitiveList м primitives, l.rest WHILE l # NIL DO
l.first.distanceSet м FALSE;
ENDLOOP;
};

InsideSolid: PUBLIC PROC [q: Triple, convexSolid: PrimitiveList] RETURNS [BOOL] ~ {
FOR l: PrimitiveList м convexSolid, l.rest WHILE l # NIL DO
l.first.distance м q.x*l.first.plane.x+q.y*l.first.plane.y+q.z*l.first.plane.z+l.first.plane.w;
l.first.distanceSet м TRUE;
IF l.first.distance > 0.0 THEN RETURN[FALSE];
ENDLOOP;
RETURN[TRUE];
};

ScalePairList: PROC [pairs: PairList, s: REAL] RETURNS [PairList] ~ {
FOR l: PairList м pairs, l.rest WHILE l # NIL DO l.first м G2dVector.Mul[l.first, s]; ENDLOOP;
RETURN[pairs];
};

LengthPairList: PROC [pairs: PairList] RETURNS [len: INTEGER м 0] ~ {
FOR l: PairList м pairs, l.rest WHILE l # NIL DO len м len+1; ENDLOOP;
};

CopyPairList: PROC [pairs: PairList] RETURNS [ret: PairList м NIL] ~ {
tmp: PairList м NIL;
FOR l: PairList м pairs, l.rest WHILE l # NIL DO tmp м CONS[l.first, tmp]; ENDLOOP;
FOR l: PairList м tmp, l.rest WHILE l # NIL DO ret м CONS[l.first, ret]; ENDLOOP;
};
DisplayPrimitive: PUBLIC PROC [p: Primitive, map: SampleMap] ~ {
ShowReflected: PROC [pa: CtBasic.PixelArray, offset: IntegerPair] ~ {
temp: SampleMap м CtBasic.SampleMapFromPixelArray[pa];
CtMod.ReflectH[temp];
ImagerSample.Transfer[map, temp, [offset.y, offset.x]];
};
IF p.image # NIL THEN ShowReflected[p.image, p.display];
IF p.thickness # NIL AND p.thickness.array # NIL
THEN ShowReflected[p.thickness.array, p.thickness.display];
IF p.buffer # NIL THEN {
line: SampleMap м ImagerSample.NewSampleMap[[[0, 0], [1, p.buffer.length]], 8];
ImagerSample.PutSamples[line, [0, 0],, p.buffer, 0, p.buffer.length];
ImagerSample.Transfer[map, line, [p.display.y, p.display.x]];
};
};

MaxIntensity: PROC [intensities: RealSequence] RETURNS [max: REAL м Real.MinusInfinity] ~ {
IF intensities # NIL THEN FOR i: INTEGER IN [0..intensities.length) DO
max м MAX[intensities[i], max];
ENDLOOP;
};

SetImagePath: PUBLIC PROC [p: Primitive, path: PairList, filter: BOOL м TRUE] ~ {
flat: BOOL м TRUE;
intensities: RealSequence м G2dBasic.CopyRealSequence[p.intensities];
p.path м ScalePairList[CopyPairList[path], p.scale];
p.valueScale м p.intensity;
IF intensities # NIL THEN {
max: REAL м MaxIntensity[intensities];
FOR i: INT IN [0..intensities.length) DO IF max # intensities[i] THEN flat м FALSE; ENDLOOP;
p.valueScale м max*p.intensity; -- normalize
FOR i: INT IN [0..intensities.length) DO intensities[i] м intensities[i]/max; ENDLOOP;
};
SELECT p.nVertices FROM
> 2 => {
MakeImage: PROC ~ {
i: INTEGER м -1;
pairs: LIST OF G2dBasic.IntegerPair м NIL;
vertices: LIST OF G2dScan.Vertex м NIL;
ImagerSample.Clear[map];
FOR l: PairList м p.path, l.rest WHILE l # NIL DO
p: IntegerPair м [Real.Round[l.first.x], Real.Round[l.first.y]];
IF flat
THEN pairs м CONS[p, pairs]
ELSE vertices м CONS[[p.x, p.y, Real.Round[255.0*intensities[i м i+1]]], vertices];
ENDLOOP;
IF flat
THEN [] м G2dScan.FlatShade[map, pairs, 255]
ELSE [] м G2dScan.GouraudShade[map, vertices];
};
box: ImagerSample.Box м [[0, 0], [p.res.y, p.res.x]];
map: SampleMap м ImagerSample.ObtainScratchMap[box, 8];
MakeImage[];
IF filter THEN {
max: CARDINAL м 0;
buf: ImagerSample.SampleBuffer м ImagerSample.NewSamples[p.res.x];
CtFilter.ResampleMap[map, box, box, p.filter]; -- unnormalized filtering & quantization
FOR y: INT IN [0..p.res.y) DO
ImagerSample.GetSamples[map, [y, 0],, buf, 0, p.res.x];
FOR x: INT IN [0..p.res.x) DO IF buf[x] > max THEN max м buf[x]; ENDLOOP;
ENDLOOP;
IF (max м max+1) IN (0..255) THEN { -- normalization of image:
MakeImage[]; -- inexpensive to recompute
p.filter.scale м 255.0/REAL[max]; -- scale filtered image so its max pixel = 255
p.valueScale м p.valueScale/p.filter.scale; -- compensate during ValueOfPrimitive
CtFilter.ResampleMap[map, box, box, p.filter]; -- normalized filtering (expensive)
p.filter.scale м 1.0; -- reset
};
};
p.image м CtBasic.PixelArrayFromSampleMap[map];
ImagerSample.ReleaseScratchMap[map];
};
2 => {
pairs: PairList м path;
box: ImagerSample.Box м [[0, 0], [1, p.res.x]];
map: SampleMap м ImagerSample.ObtainScratchMap[box, 8];
line: ImagerSample.SampleBuffer ~ ImagerSample.ObtainScratchSamples[p.res.x];
FOR x: INT IN [0..p.res.x) DO
line.samples[x] м IF x IN [pairs.first.x..pairs.rest.first.x] THEN 255 ELSE 0;
ENDLOOP;
IF NOT flat THEN
FOR x: INT IN [0..p.res.x) DO
a: REAL м REAL[x]/REAL[p.res.x-1];
factor: REAL м p.intensities[0]+a*(p.intensities[1]-p.intensities[0]);
line.samples[x] м Real.Round[factor*REAL[line.samples[x]]];
ENDLOOP;
ImagerSample.PutSamples[map, [0, 0],, line, 0, p.res.x];
IF filter THEN CtFilter.ResampleMap[map, box, box, p.filter];
ImagerSample.GetSamples[map,,, p.buffer м ImagerSample.NewSamples[p.res.x]];
ImagerSample.ReleaseScratchSamples[line];
ImagerSample.ReleaseScratchMap[map];
};
1 => NULL;
ENDCASE;
};
DrawPrimitive: PUBLIC PROC [
p: Primitive,
context: Context,
view: Matrix,
viewport: Viewport м [],
whatChanged: REF м NIL,
type: DrawType,
log: IO.STREAM м NIL]
~ {
T: PROC [i: INT] RETURNS [t: Triple] ~ {t м GetTwisted[p, GetPoint[p, i]]};
close: BOOL м p.nVertices > 2;
G3dDraw.SetColor[context, [p.color.R, p.color.G, p.color.B]];
IF p.twist.tw0 # 0 OR p.twist.tw1 # 0
THEN
G3dDraw.DrawWithConnectedPoints[context, p.nVertices, T, view, viewport, close, type]
ELSE
G3dDraw.ConnectedPoints[context, p.points, view, viewport, close, type];
};
DrawPrimitives: PUBLIC PROC [
list: LIST OF Primitive,
context: Context,
view: Matrix,
viewport: Viewport м [],
whatChanged: REF м NIL,
type: DrawType,
log: IO.STREAM м NIL]
~ {
IF whatChanged = $IPOut THEN Imager.SetStrokeWidth[context, 3.0];
FOR l: LIST OF Primitive м list, l.rest WHILE l # NIL DO
IF l.first.active
THEN DrawPrimitive[l.first, context, view, viewport, whatChanged, type, log];
ENDLOOP;
};
Out: PROC [message: ROPE] ~ {ImplicitDebug.Write[message]};

PrintTriple: PROC [name: ROPE, t: Triple] ~ {
Out[IO.PutFLR["%g: (%g, %g, %g)\n",
LIST[IO.rope[name], IO.real[t.x], IO.real[t.y], IO.real[t.z]]]];
};

Commander.Register["ImplicitConvolve", ImplicitDesign.DesignCmd, "ImplicitConvolve [option | ?]"];

END...


