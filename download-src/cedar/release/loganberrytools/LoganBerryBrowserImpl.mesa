name _ PFSNames.ExpandName[PFS.PathFromRope[d.first.schema.dbName]];
d.first.schema.dbName _ PFS.RopeFromPath[name];
comp _ PFSNames.ShortName[name];
d.first.shortname _ comp.name.base;
ENDLOOP;
