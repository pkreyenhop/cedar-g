-- LibraryWorkout.mesa — exercises the standard Cedar interfaces the
-- interpreter provides: Rope, Convert, RealFns, Basics, List and IO.
LibraryWorkoutImpl: CEDAR PROGRAM
  IMPORTS IO, Rope, Convert, RealFns, Basics, List
= {
  -- Rope (text) --------------------------------------------------------------
  name: Rope.ROPE ← Rope.Cat["Grace", " ", "Hopper"];
  IO.PutF["Rope.Cat        = %g\n", name];
  IO.PutF["Rope.Length     = %g\n", Rope.Length[name]];
  IO.PutF["Rope.Substr 6,6 = %g\n", Rope.Substr[name, 6, 6]];
  IO.PutF["Rope.Find 'Hop' = %g\n", Rope.Find[name, "Hop"]];
  IO.PutF["Rope.Equal fold = %g\n", Rope.Equal["yes", "YES", FALSE]];

  -- Convert (text <-> numbers) ------------------------------------------------
  yr: INT ← Convert.IntFromRope["1906"];
  IO.PutF["Convert round   = %g -> %g\n", yr, Convert.RopeFromInt[yr + 100]];

  -- RealFns (floating point) --------------------------------------------------
  IO.PutF["RealFns.Sqrt 2  = %g\n", RealFns.Sqrt[2.0]];
  IO.PutF["RealFns.Power   = %g\n", RealFns.Power[2.0, 10.0]];

  -- Basics (bit operations) ---------------------------------------------------
  IO.PutF["Basics.BITAND   = %g\n", Basics.BITAND[12, 10]];
  IO.PutF["Basics.BITOR    = %g\n", Basics.BITOR[12, 10]];
  IO.PutF["Basics.BITXOR   = %g\n", Basics.BITXOR[12, 10]];

  -- List (linked lists) -------------------------------------------------------
  xs: LIST OF INTEGER ← LIST[3, 1, 4, 1, 5, 9];
  IO.PutF["List length     = %g\n", List.Length[xs]];
  IO.PutF["List.Reverse hd = %g\n", List.Reverse[xs].first];

  -- IO.PutF format codes ------------------------------------------------------
  IO.PutF["IO formats      = dec %d  hex %x  oct %o  char %c\n", 255, 255, 255, 65];
}.
