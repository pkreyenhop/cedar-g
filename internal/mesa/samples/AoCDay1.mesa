-- AoCDay1.mesa -- Advent of Code, Day 1 ("Historian Hysteria" style).
-- Two lists of location IDs are given as columns. Part 1 pairs them up in
-- sorted order and sums the distances; Part 2 scores each left value by how
-- often it appears on the right. Runs on the Go Cedar interpreter using the
-- puzzle's published example input, whose answers are 11 and 31.

AoCDay1: CEDAR PROGRAM ~ {

  N: INTEGER ~ 6;                   -- number of location-id pairs
  left:  ARRAY [0..N) OF INTEGER;   -- the two columns of the input
  right: ARRAY [0..N) OF INTEGER;

  -- The puzzle input. There is no file I/O here, so it is embedded; swap these
  -- assignments for the real input to solve your own puzzle.
  LoadInput: PROCEDURE ~ {
    left[0] ← 3; right[0] ← 4;
    left[1] ← 4; right[1] ← 3;
    left[2] ← 2; right[2] ← 5;
    left[3] ← 1; right[3] ← 3;
    left[4] ← 3; right[4] ← 9;
    left[5] ← 3; right[5] ← 3;
  };

  -- Bubble-sort both columns ascending, in place.
  SortColumns: PROCEDURE ~ {
    i, j, t: INTEGER;
    FOR i IN [0..N) DO
      FOR j IN [0..N-1) DO
        IF left[j] > left[j+1] THEN {
          t ← left[j]; left[j] ← left[j+1]; left[j+1] ← t };
        IF right[j] > right[j+1] THEN {
          t ← right[j]; right[j] ← right[j+1]; right[j+1] ← t };
      ENDLOOP;
    ENDLOOP;
  };

  -- Part 1: pair the sorted lists and sum the absolute differences.
  TotalDistance: PROCEDURE RETURNS [INTEGER] ~ {
    i, sum: INTEGER;
    sum ← 0;
    FOR i IN [0..N) DO sum ← sum + ABS[left[i] - right[i]]; ENDLOOP;
    RETURN [sum];
  };

  -- How many times v appears in the right list.
  CountInRight: PROCEDURE [v: INTEGER] RETURNS [INTEGER] ~ {
    i, c: INTEGER;
    c ← 0;
    FOR i IN [0..N) DO IF right[i] = v THEN c ← c + 1; ENDLOOP;
    RETURN [c];
  };

  -- Part 2: each left value scores itself times its count in the right list.
  Similarity: PROCEDURE RETURNS [INTEGER] ~ {
    i, score: INTEGER;
    score ← 0;
    FOR i IN [0..N) DO score ← score + left[i] * CountInRight[left[i]]; ENDLOOP;
    RETURN [score];
  };

  -- Main.
  LoadInput[];
  SortColumns[];
  IO.PutF["Part 1  total distance:   %d\n", TotalDistance[]];
  IO.PutF["Part 2  similarity score: %d\n", Similarity[]];
}.
