-- FibonacciRec.mesa: the Fibonacci sequence computed recursively.
-- Contrast with Fibonacci.mesa, which uses an iterative loop.

FibonacciRec: PROGRAM =
BEGIN
  Fib: PROCEDURE [n: CARDINAL] RETURNS [CARDINAL] =
    BEGIN
      IF n < 2 THEN RETURN [n];
      RETURN [Fib[n - 1] + Fib[n - 2]];
    END;

  n: CARDINAL;
  FOR n IN [0..15] DO
    IO.PutF["fib[%g] = %g\n", n, Fib[n]];
  ENDLOOP;
END.
