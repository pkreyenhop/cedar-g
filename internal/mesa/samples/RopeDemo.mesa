-- RopeDemo.mesa — the Rope and Convert interfaces on text.
RopeDemoImpl: CEDAR PROGRAM
  IMPORTS IO, Rope, Convert
= {
  name: Rope.ROPE ← Rope.Cat["Ada", " ", "Lovelace"];
  IO.PutF["name       = %g\n", name];
  IO.PutF["length     = %g\n", Rope.Length[name]];
  IO.PutF["substr 4,8 = %g\n", Rope.Substr[name, 4, 8]];
  IO.PutF["upper      = %g\n", Rope.Upper[name]];

  n: INT ← Convert.IntFromRope["1815"];
  IO.PutF["born       = %g\n", n];
  IO.PutF["born+200   = %g\n", Convert.RopeFromInt[n + 200]];

  IF Rope.Equal["yes", "YES", FALSE] THEN IO.PutRope["case-insensitive match\n"];
}.
