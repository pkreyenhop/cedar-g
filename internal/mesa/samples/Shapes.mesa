-- Shapes.mesa -- enumerations, records, nested record constructors,
-- and a SELECT statement dispatching on an enumeration.

Shapes: PROGRAM =
BEGIN
  Color: TYPE = {red, green, blue};
  Point: TYPE = RECORD [x, y: INTEGER];
  Shape: TYPE = RECORD [origin: Point, color: Color, sides: INTEGER];

  ColorName: PROCEDURE [c: Color] RETURNS [STRING] =
    BEGIN
      SELECT c FROM
        red   => RETURN ["red"];
        green => RETURN ["green"];
        blue  => RETURN ["blue"];
        ENDCASE => RETURN ["?"];
    END;

  Describe: PROCEDURE [s: Shape] =
    BEGIN
      IO.PutF["shape at (%g, %g), color %g, %g sides\n",
              s.origin.x, s.origin.y, ColorName[s.color], s.sides];
    END;

  -- named field constructor, with a nested constructor for origin
  tri: Shape ← [origin: [x: 1, y: 2], color: green, sides: 3];
  -- positional constructor
  box: Shape ← [[10, 20], blue, 4];

  Describe[tri];
  Describe[box];
END.
