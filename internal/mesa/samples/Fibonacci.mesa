-- Fibonacci.mesa: iterative computation with local variables and a
-- half-open interval FOR loop [0..n).

Fibonacci: PROGRAM =
BEGIN
  Fib: PROCEDURE [n: CARDINAL] RETURNS [CARDINAL] =
    BEGIN
      a: CARDINAL ← 0;
      b: CARDINAL ← 1;
      i: CARDINAL;
      FOR i IN [0..n) DO
        t: CARDINAL ← a + b;
        a ← b;
        b ← t;
      ENDLOOP;
      RETURN [a];
    END;

  n: CARDINAL;
  FOR n IN [0..15] DO
    IO.PutF["fib[%g] = %g\n", n, Fib[n]];
  ENDLOOP;
END.
