-- SafeDivide.mesa — ERROR raising and catching with a call-site "! h" clause.
SafeDivideImpl: CEDAR PROGRAM
  IMPORTS IO
= {
  DivideByZero: ERROR = CODE;

  Divide: PROC [a, b: INTEGER] RETURNS [INTEGER] = {
    IF b = 0 THEN ERROR DivideByZero;
    RETURN[a / b];
  };

  Try: PROC [a, b: INTEGER] = {
    q: INTEGER ← Divide[a, b ! DivideByZero => { IO.PutF["%g/%g undefined\n", a, b]; RETURN }];
    IO.PutF["%g/%g = %g\n", a, b, q];
  };

  Try[10, 2];
  Try[7, 0];
  Try[20, 5];
}.
