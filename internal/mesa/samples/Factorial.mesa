-- Factorial.mesa -- recursion, procedures with RETURNS, and a FOR loop.

Factorial: PROGRAM =
BEGIN
  Fact: PROCEDURE [n: INTEGER] RETURNS [INTEGER] =
    BEGIN
      IF n <= 1 THEN RETURN [1];
      RETURN [n * Fact[n - 1]];
    END;

  i: INTEGER;
  FOR i IN [1..10] DO
    IO.PutF["%g! = %g\n", i, Fact[i]];
  ENDLOOP;
END.
