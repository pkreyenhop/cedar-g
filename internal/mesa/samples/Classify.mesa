-- Classify.mesa — SELECT used as an expression with equality and open guards.
ClassifyImpl: CEDAR PROGRAM
  IMPORTS IO
= {
  Classify: PROC [n: INTEGER] RETURNS [Rope.ROPE] = {
    RETURN[SELECT n FROM
      < 0     => "negative",
      0       => "zero",
      1, 2, 3 => "small",
      IN [4..9] => "medium",
      ENDCASE => "large"];
  };

  FOR i: INTEGER IN [-1..12] DO
    IO.PutF["%g -> %g\n", i, Classify[i]];
  ENDLOOP;
}.
