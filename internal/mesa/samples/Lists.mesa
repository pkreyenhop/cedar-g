-- Lists.mesa — LIST OF T: construction, first/rest, CONS, reverse and length.
ListsImpl: CEDAR PROGRAM
  IMPORTS IO, List
= {
  Sum: PROC [l: LIST OF INTEGER] RETURNS [total: INTEGER] = {
    total ← 0;
    FOR p: LIST OF INTEGER ← l, p.rest UNTIL p = NIL DO
      total ← total + p.first;
    ENDLOOP;
  };

  xs: LIST OF INTEGER ← LIST[1, 2, 3, 4, 5];
  IO.PutF["length = %g\n", LENGTH[xs]];
  IO.PutF["sum    = %g\n", Sum[xs]];
  IO.PutF["head   = %g\n", xs.first];
  IO.PutF["second = %g\n", xs.rest.first];

  ys: LIST OF INTEGER ← List.Reverse[xs];
  IO.PutF["reversed head = %g\n", ys.first];

  zs: LIST OF INTEGER ← CONS[0, xs];
  IO.PutF["consed length = %g\n", LENGTH[zs]];
}.
