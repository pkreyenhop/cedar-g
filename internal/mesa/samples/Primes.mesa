-- Primes.mesa -- Sieve of Eratosthenes using an ARRAY of BOOLEAN,
-- nested loops, WHILE, and a compile-time constant array bound.

Primes: PROGRAM =
BEGIN
  N: INTEGER = 50;
  sieve: ARRAY [0..N] OF BOOLEAN;
  i, j: INTEGER;

  FOR i IN [0..N] DO sieve[i] ← TRUE ENDLOOP;
  sieve[0] ← FALSE;
  sieve[1] ← FALSE;

  FOR i IN [2..N] DO
    IF sieve[i] THEN
      BEGIN
        j ← i + i;
        WHILE j <= N DO
          sieve[j] ← FALSE;
          j ← j + i;
        ENDLOOP;
      END;
  ENDLOOP;

  IO.PutRope["Primes up to 50:"];
  FOR i IN [2..N] DO
    IF sieve[i] THEN IO.PutF[" %g", i];
  ENDLOOP;
  IO.PutChar[10];  -- newline
END.
